{% doc %}
  Renders a policy page (warranty, returns, delivery, terms, privacy): a
  centred heading with an optional "last updated" date, above a readable
  card of text. The text can come from one of Shopify's built-in policies
  (Settings > Policies) or be typed into the section's own text box, which
  suits policies that Shopify has no box for, such as a warranty.

  @example
  {% section 'policy-page' %}
{% enddoc %}

{% liquid
  assign policy_body = ''
  case section.settings.content_source
    when 'terms_of_service'
      assign policy_body = shop.terms_of_service.body
    when 'privacy_policy'
      assign policy_body = shop.privacy_policy.body
    when 'refund_policy'
      assign policy_body = shop.refund_policy.body
    when 'shipping_policy'
      assign policy_body = shop.shipping_policy.body
  endcase
%}

<div class="policy-page full-width">
  <div class="policy-page__inner">
    <div class="policy-page__header">
      {% if section.settings.eyebrow != blank %}
        <span class="policy-page__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="policy-page__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.last_updated != blank %}
        <p class="policy-page__updated">{{ 'policy_page.last_updated' | t }} {{ section.settings.last_updated }}</p>
      {% endif %}
    </div>

    <div class="policy-page__card">
      <div class="policy-page__content">
        {% if policy_body != blank %}
          {{ policy_body }}
        {% else %}
          {{ section.settings.content }}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .policy-page {
    padding: 4.5rem 0;
    background-color: #ffffff;
  }

  .policy-page__inner {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .policy-page__header {
    text-align: center;
  }

  .policy-page__eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6e;
  }

  .policy-page__heading {
    margin: 0.6rem 0 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .policy-page__updated {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: #85858b;
  }

  .policy-page__card {
    margin-top: 2.25rem;
    padding: 2.5rem;
    border: 1px solid #e5e5e7;
    border-radius: 1rem;
    background-color: #ffffff;
  }

  .policy-page__content {
    font-size: 0.95rem;
    line-height: 1.75;
    color: #4a4a4d;
  }

  .policy-page__content > :first-child {
    margin-top: 0;
  }

  .policy-page__content > :last-child {
    margin-bottom: 0;
  }

  .policy-page__content h1,
  .policy-page__content h2,
  .policy-page__content h3,
  .policy-page__content h4 {
    margin: 2.25rem 0 0.75rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-transform: uppercase;
    color: #1f2120;
  }

  .policy-page__content h1,
  .policy-page__content h2 {
    font-size: 1.15rem;
  }

  .policy-page__content h3,
  .policy-page__content h4 {
    font-size: 1rem;
  }

  .policy-page__content p {
    margin: 0 0 1rem;
  }

  .policy-page__content ul,
  .policy-page__content ol {
    margin: 0 0 1rem;
    padding-left: 1.4rem;
  }

  .policy-page__content li {
    margin: 0 0 0.4rem;
    padding-left: 0.25rem;
  }

  .policy-page__content li > ul,
  .policy-page__content li > ol {
    margin: 0.4rem 0 0.4rem;
  }

  .policy-page__content strong,
  .policy-page__content b {
    font-weight: 700;
    color: #1f2120;
  }

  .policy-page__content a {
    color: #1f2120;
    text-decoration: underline;
  }

  .policy-page__content a:hover {
    color: #52564f;
  }

  @media screen and (max-width: 589px) {
    .policy-page {
      padding: 3rem 0;
    }

    .policy-page__heading {
      font-size: 1.6rem;
    }

    .policy-page__card {
      padding: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.policy_page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Policy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Policy"
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "t:labels.last_updated"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "t:labels.policy_source",
      "info": "t:labels.policy_source_info",
      "default": "custom",
      "options": [
        { "value": "custom", "label": "t:options.policy_source.custom" },
        { "value": "terms_of_service", "label": "t:options.policy_source.terms_of_service" },
        { "value": "privacy_policy", "label": "t:options.policy_source.privacy_policy" },
        { "value": "refund_policy", "label": "t:options.policy_source.refund_policy" },
        { "value": "shipping_policy", "label": "t:options.policy_source.shipping_policy" }
      ]
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:labels.policy_content"
    }
  ],
  "presets": [
    {
      "name": "t:general.policy_page"
    }
  ]
}
{% endschema %}
