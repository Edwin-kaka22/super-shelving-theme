{% doc %}
  Renders a full-width scrolling marquee announcement bar. The message
  repeats continuously and scrolls left to right in an infinite loop.

  @example
  {% section 'announcement-bar' %}
{% enddoc %}

{% liquid
  assign message = section.settings.text | default: '20% off storewide!'
%}

<div
  class="announcement-bar full-width"
  style="--announcement-background: {{ section.settings.background_color }}; --announcement-color: {{ section.settings.text_color }};"
>
  <div class="announcement-bar__track">
    <div class="announcement-bar__group">
      {% for i in (1..8) %}
        <span class="announcement-bar__item">{{ message }}</span>
      {% endfor %}
    </div>
    <div class="announcement-bar__group" aria-hidden="true">
      {% for i in (1..8) %}
        <span class="announcement-bar__item">{{ message }}</span>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .announcement-bar {
    overflow: hidden;
    background-color: var(--announcement-background);
    color: var(--announcement-color);
  }

  .announcement-bar__track {
    display: flex;
    width: max-content;
    animation: announcement-bar-scroll 50s linear infinite;
  }

  .announcement-bar__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .announcement-bar__item {
    padding: 0.65rem 2rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @keyframes announcement-bar-scroll {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.announcement_bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "20% off storewide!"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#f8ba26"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#1f2120"
    }
  ],
  "presets": [
    {
      "name": "t:general.announcement_bar"
    }
  ]
}
{% endschema %}
