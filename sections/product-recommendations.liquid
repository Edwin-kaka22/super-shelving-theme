{% doc %}
  Renders a "You may also like" grid of product cards at the bottom of the
  product page.

  The grid is server-rendered with other available products so it is never
  empty, then replaced in the browser with Shopify's real related-product
  recommendations when they are available. Also handles add-to-cart on the
  cards, including cards injected after page load.

  @example
  {% section 'product-recommendations' %}
{% enddoc %}

{% assign limit = section.settings.products_shown %}

<div class="product-recommendations full-width">
  <div class="product-recommendations__inner">
    {% if section.settings.heading != blank %}
      <h2 class="product-recommendations__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if recommendations.performed and recommendations.products_count > 0 %}
      <div class="product-recommendations__grid" data-recommendations-grid data-source="recommendations">
        {% for recommended in recommendations.products limit: limit %}
          {% render 'product-card', product: recommended %}
        {% endfor %}
      </div>
    {% else %}
      <div
        class="product-recommendations__grid"
        data-recommendations-grid
        data-source="fallback"
        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent=related"
      >
        {% assign shown = 0 %}
        {% for other in collections['all'].products %}
          {% if other.id != product.id and other.available %}
            {% render 'product-card', product: other %}
            {% assign shown = shown | plus: 1 %}
            {% if shown >= limit %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .product-recommendations {
    --page-width: 103rem;
    padding: 3.5rem 0 4.5rem;
    border-top: 1px solid #e5e5e7;
    background-color: #ffffff;
  }

  .product-recommendations__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .product-recommendations__heading {
    margin: 0 0 2rem;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-align: center;
    text-transform: uppercase;
    color: #1f2120;
  }

  .product-recommendations__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2.5rem 1.5rem;
  }

  @media screen and (max-width: 749px) {
    .product-recommendations__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1rem;
    }

    .product-recommendations .product-card__add {
      min-width: 0;
      width: 100%;
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var grid = document.querySelector('[data-recommendations-grid]');
    var url = grid ? grid.getAttribute('data-url') : null;

    if (url) {
      fetch(url)
        .then(function (response) { return response.ok ? response.text() : ''; })
        .then(function (html) {
          if (!html) return;
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var fresh = doc.querySelector('[data-recommendations-grid]');
          if (fresh && fresh.getAttribute('data-source') === 'recommendations' && fresh.children.length) {
            grid.innerHTML = fresh.innerHTML;
            grid.setAttribute('data-source', 'recommendations');
          }
        })
        .catch(function () {});
    }

    document.addEventListener('submit', function (event) {
      var form = event.target;
      if (!form || !form.matches || !form.matches('[data-card-add-to-cart]')) return;
      event.preventDefault();

      var button = form.querySelector('.product-card__add');
      var label = form.querySelector('[data-card-add-label]');
      if (!button || !label || button.disabled) return;

      var originalText = label.textContent;
      button.disabled = true;
      label.textContent = form.getAttribute('data-adding-text');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ id: form.elements['id'].value, quantity: 1 })
      })
        .then(function (response) {
          if (!response.ok) throw new Error('add_to_cart_failed');
          return fetch('/cart.js');
        })
        .then(function (response) { return response.json(); })
        .then(function (cart) {
          var cartCountEl = document.querySelector('.header__icons a[href*="/cart"] sup');
          if (cartCountEl) {
            cartCountEl.textContent = cart.item_count;
          } else if (cart.item_count > 0) {
            var cartLink = document.querySelector('.header__icons a[href*="/cart"]');
            if (cartLink) {
              var sup = document.createElement('sup');
              sup.textContent = cart.item_count;
              cartLink.insertBefore(sup, cartLink.firstChild);
            }
          }

          button.classList.add('is-added');
          label.textContent = form.getAttribute('data-added-text');

          setTimeout(function () {
            button.classList.remove('is-added');
            button.disabled = false;
            label.textContent = originalText;
          }, 1500);
        })
        .catch(function () {
          button.disabled = false;
          label.textContent = originalText;
        });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product_recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_shown",
      "label": "t:labels.products_shown",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:general.product_recommendations"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
