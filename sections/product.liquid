{% doc %}
  Renders the product page: breadcrumbs, an image gallery with thumbnails,
  the product title, price, stock level, optional variant selector, quantity
  stepper and add-to-cart button, a row of store trust points, and the full
  product description.

  Also records the product in the visitor's "recently viewed" list (stored in
  localStorage) which the collection page reads from.

  @example
  {% section 'product' %}
{% enddoc %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
%}

<div class="pdp full-width" data-product-page data-product-handle="{{ product.handle }}">
  <div class="pdp__inner">
    <nav class="pdp__breadcrumbs" aria-label="{{ 'products.product.breadcrumbs' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      <span class="pdp__breadcrumbs-sep">/</span>
      {% if collection %}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">{{ 'collections.general.all_products_title' | t }}</a>
      {% endif %}
      <span class="pdp__breadcrumbs-sep">/</span>
      <span class="pdp__breadcrumbs-current">{{ product.title }}</span>
    </nav>

    <div class="pdp__layout">
      <div class="pdp__gallery">
        <div class="pdp__main-image">
          {% if product.featured_image %}
            <img
              data-gallery-main
              src="{{ product.featured_image | image_url: width: 1000 }}"
              srcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 1000 }} 1000w, {{ product.featured_image | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 990px) 50vw, 100vw"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              fetchpriority="high"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'pdp__placeholder' }}
          {% endif %}

          {% if on_sale %}
            <span class="pdp__badge">{{ 'collections.general.sale' | t }}</span>
          {% elsif product.available == false %}
            <span class="pdp__badge pdp__badge--sold-out">{{ 'collections.general.sold_out' | t }}</span>
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="pdp__thumbs">
            {% for image in product.images %}
              <button
                type="button"
                class="pdp__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb
                data-src="{{ image | image_url: width: 1000 }}"
                data-srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1000 }} 1000w, {{ image | image_url: width: 1400 }} 1400w"
                data-alt="{{ image.alt | default: product.title | escape }}"
                aria-label="{{ 'products.product.view_image' | t: number: forloop.index }}"
              >
                <img src="{{ image | image_url: width: 160 }}" alt="" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="pdp__info">
        <h1 class="pdp__title">{{ product.title }}</h1>

        <p class="pdp__price">
          <span class="pdp__price-current" data-product-price>{{ current_variant.price | money }}</span>
          <span class="pdp__price-compare" data-product-compare{% unless on_sale %} hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</span>
        </p>

        {% if current_variant.inventory_management == 'shopify' %}
          {% assign stock_qty = current_variant.inventory_quantity %}
          {% assign stock_percent = stock_qty | at_most: 20 | at_least: 0 | times: 100 | divided_by: 20 | at_most: 80 %}
          {% if stock_qty > 0 %}
            {% assign stock_percent = stock_percent | at_least: 4 %}
          {% endif %}
          {% if stock_qty <= 0 %}
            {% assign stock_level = 'low' %}
          {% elsif stock_qty <= 20 %}
            {% assign stock_level = 'medium' %}
          {% else %}
            {% assign stock_level = 'high' %}
          {% endif %}
          <div class="pdp__stock" data-product-stock>
            <div class="pdp__stock-bar">
              <div
                class="pdp__stock-fill pdp__stock-fill--{{ stock_level }}"
                data-stock-fill
                style="width: {{ stock_percent }}%"
              ></div>
            </div>
            <span class="pdp__stock-label" data-stock-label>
              {% if stock_qty <= 0 %}
                {{ 'collections.general.no_stock' | t }}
              {% elsif stock_qty <= 20 %}
                {{ 'collections.general.low_stock' | t: count: stock_qty }}
              {% else %}
                {{ 'collections.general.in_stock' | t: count: stock_qty }}
              {% endif %}
            </span>
          </div>
        {% else %}
          <div class="pdp__stock" data-product-stock hidden>
            <div class="pdp__stock-bar"><div class="pdp__stock-fill" data-stock-fill></div></div>
            <span class="pdp__stock-label" data-stock-label></span>
          </div>
        {% endif %}

        {% form 'product', product, class: 'pdp__form', data-product-form: '' %}
          {% if product.variants.size > 1 %}
            <label class="pdp__field">
              <span>{{ 'products.product.options' | t }}</span>
              <select name="id" class="pdp__select" data-variant-select>
                {% for variant in product.variants %}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == current_variant %}
                      selected
                    {% endif %}
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {{ variant.title }}{% unless variant.available %} ({{ 'collections.general.sold_out' | t }}){% endunless %}
                  </option>
                {% endfor %}
              </select>
            </label>
          {% else %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% endif %}

          <div class="pdp__buy-row">
            <div class="pdp__qty">
              <button type="button" class="pdp__qty-btn" data-qty-minus aria-label="{{ 'products.product.decrease_quantity' | t }}">&minus;</button>
              <input
                type="number"
                name="quantity"
                class="pdp__qty-input"
                value="1"
                min="1"
                inputmode="numeric"
                aria-label="{{ 'products.product.quantity' | t }}"
                data-qty-input
              >
              <button type="button" class="pdp__qty-btn" data-qty-plus aria-label="{{ 'products.product.increase_quantity' | t }}">+</button>
            </div>

            <button
              type="submit"
              class="pdp__add"
              data-add-button
              {% unless current_variant.available %}
                disabled
              {% endunless %}
            >
              <span data-add-label>
                {% if current_variant.available %}
                  {{ 'collections.general.add_to_cart' | t }}
                {% else %}
                  {{ 'collections.general.sold_out' | t }}
                {% endif %}
              </span>
            </button>
          </div>

          <div class="pdp__payment">
            {{ form | payment_button }}
          </div>
        {% endform %}

        <ul class="pdp__trust">
          <li class="pdp__trust-item">
            <span class="pdp__trust-icon">{{ 'icon-pin.svg' | inline_asset_content }}</span>
            <span>{{ 'products.product.trust_warehouse' | t }}</span>
          </li>
          <li class="pdp__trust-item">
            <span class="pdp__trust-icon">{{ 'icon-package.svg' | inline_asset_content }}</span>
            <span>{{ 'products.product.trust_delivery' | t }}</span>
          </li>
          <li class="pdp__trust-item">
            <span class="pdp__trust-icon">{{ 'icon-medal.svg' | inline_asset_content }}</span>
            <span>{{ 'products.product.trust_warranty' | t }}</span>
          </li>
        </ul>
      </div>
    </div>

    {% if product.description != blank %}
      <div class="pdp__details">
        <h2 class="pdp__details-heading">{{ 'products.product.details' | t }}</h2>
        <div class="pdp__description">{{ product.description }}</div>
      </div>
    {% endif %}
  </div>

  <script type="application/json" data-product-i18n>
    {
      "adding": {{ 'collections.general.adding' | t | json }},
      "added": {{ 'collections.general.added' | t | json }},
      "addToCart": {{ 'collections.general.add_to_cart' | t | json }},
      "soldOut": {{ 'collections.general.sold_out' | t | json }},
      "noStock": {{ 'collections.general.no_stock' | t | json }},
      "lowStock": {{ 'collections.general.low_stock' | t: count: '__COUNT__' | json }},
      "inStock": {{ 'collections.general.in_stock' | t: count: '__COUNT__' | json }}
    }
  </script>

  <script type="application/json" data-product-variants>
    [
      {% for variant in product.variants %}
        {
          "id": {{ variant.id }},
          "price": {{ variant.price | money | json }},
          "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "available": {{ variant.available | json }},
          "tracked": {% if variant.inventory_management == 'shopify' %}true{% else %}false{% endif %},
          "qty": {{ variant.inventory_quantity | default: 0 }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</div>

{% stylesheet %}
  .pdp {
    background-color: #ffffff;
  }

  .pdp__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 1.75rem var(--page-margin) 4rem;
  }

  .pdp__breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
    font-size: 0.8rem;
    color: #9a9a9d;
  }

  .pdp__breadcrumbs a {
    color: #6b6b6e;
    text-decoration: none;
  }

  .pdp__breadcrumbs a:hover {
    color: #1f2120;
    text-decoration: underline;
  }

  .pdp__breadcrumbs-current {
    color: #9a9a9d;
  }

  .pdp__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  /* Gallery */

  .pdp__main-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #f4f4f5;
  }

  .pdp__main-image img,
  .pdp__main-image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pdp__badge {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background-color: #f5c02e;
    color: #1a1a1a;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .pdp__badge--sold-out {
    background-color: #6b6b6e;
    color: #ffffff;
  }

  .pdp__thumbs {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
  }

  .pdp__thumb {
    flex: none;
    width: 4.75rem;
    height: 4.75rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: #f4f4f5;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .pdp__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pdp__thumb:hover {
    opacity: 1;
  }

  .pdp__thumb.is-active {
    border-color: #1f2120;
    opacity: 1;
  }

  /* Info column */

  .pdp__title {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .pdp__price {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 1rem 0 0;
    font-weight: 700;
    color: #1f2120;
  }

  .pdp__price-current {
    font-size: 1.75rem;
  }

  .pdp__price-compare {
    font-size: 1.1rem;
    font-weight: 500;
    color: #9a9a9d;
    text-decoration: line-through;
  }

  .pdp__price-compare[hidden] {
    display: none;
  }

  .pdp__stock {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 12rem;
    margin-top: 1.1rem;
  }

  .pdp__stock[hidden] {
    display: none;
  }

  .pdp__stock-bar {
    width: 100%;
    height: 0.25rem;
    border-radius: 999px;
    background-color: #e5e5e7;
    overflow: hidden;
  }

  .pdp__stock-fill {
    height: 100%;
    border-radius: 999px;
    background-color: #f5c02e;
  }

  .pdp__stock-fill--high {
    background-color: #34a853;
  }

  .pdp__stock-fill--low {
    background-color: #ff3333;
  }

  .pdp__stock-label {
    font-size: 0.8rem;
    font-weight: 500;
    color: #6b6b6e;
  }

  .pdp__form {
    margin-top: 1.75rem;
  }

  .pdp__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #1f2120;
  }

  .pdp__select {
    padding: 0.7rem 0.9rem;
    border: 1px solid #e5e5e7;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    color: #1f2120;
  }

  .pdp__buy-row {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
  }

  .pdp__qty {
    display: flex;
    align-items: center;
    border: 1px solid #e5e5e7;
    border-radius: 999px;
    overflow: hidden;
  }

  .pdp__qty-btn {
    width: 2.75rem;
    height: 100%;
    min-height: 3rem;
    border: none;
    background: none;
    font-size: 1.15rem;
    color: #1f2120;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .pdp__qty-btn:hover {
    background-color: #f4f4f5;
  }

  .pdp__qty-input {
    width: 2.75rem;
    border: none;
    background: none;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 600;
    color: #1f2120;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .pdp__qty-input::-webkit-outer-spin-button,
  .pdp__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pdp__qty-input:focus-visible {
    outline: none;
  }

  .pdp__add {
    position: relative;
    flex: 1;
    overflow: hidden;
    min-height: 3rem;
    padding: 0 1.5rem;
    border: 1px solid #1f2120;
    border-radius: 999px;
    background-color: #1f2120;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .pdp__add::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: #52564f;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .pdp__add:hover:not(:disabled)::before {
    transform: scaleX(1);
  }

  .pdp__add:hover:not(:disabled) {
    border-color: #52564f;
  }

  .pdp__add [data-add-label] {
    position: relative;
    z-index: 1;
  }

  .pdp__add:disabled {
    background-color: #e5e5e7;
    border-color: #e5e5e7;
    color: #9a9a9d;
    cursor: default;
  }

  .pdp__add.is-added {
    background-color: #4a7c6f;
    border-color: #4a7c6f;
  }

  .pdp__payment {
    margin-top: 0.75rem;
  }

  .pdp__trust {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid #e5e5e7;
    list-style: none;
  }

  .pdp__trust-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: #4a4a4d;
  }

  .pdp__trust-icon {
    flex: none;
    display: flex;
    color: #1f2120;
    --icon-stroke-width: 1.6;
  }

  .pdp__trust-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  /* Description */

  .pdp__details {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid #e5e5e7;
  }

  .pdp__details-heading {
    margin: 0 0 1.25rem;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .pdp__description {
    max-width: 52rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #4a4a4d;
  }

  .pdp__description p {
    margin: 0 0 1rem;
  }

  .pdp__description ul,
  .pdp__description ol {
    margin: 0 0 1.25rem;
    padding-left: 1.4rem;
  }

  .pdp__description li {
    margin-bottom: 0.4rem;
  }

  .pdp__description b,
  .pdp__description strong {
    font-weight: 700;
    color: #1f2120;
  }

  .pdp__description img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  @media screen and (max-width: 989px) {
    .pdp__layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .pdp__title {
      font-size: 1.5rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var root = document.querySelector('[data-product-page]');
    if (!root) return;

    var i18n = {};
    var variants = [];
    try {
      i18n = JSON.parse(root.querySelector('[data-product-i18n]').textContent);
    } catch (e) {}
    try {
      variants = JSON.parse(root.querySelector('[data-product-variants]').textContent);
    } catch (e) {}

    try {
      var recentlyViewedKey = 'recentlyViewed';
      var currentHandle = root.getAttribute('data-product-handle');
      if (currentHandle) {
        var stored = JSON.parse(localStorage.getItem(recentlyViewedKey) || '[]');
        stored = stored.filter(function (handle) { return handle !== currentHandle; });
        stored.unshift(currentHandle);
        localStorage.setItem(recentlyViewedKey, JSON.stringify(stored.slice(0, 8)));
      }
    } catch (e) {}

    var mainImage = root.querySelector('[data-gallery-main]');
    var thumbs = root.querySelectorAll('[data-gallery-thumb]');
    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        if (!mainImage) return;
        mainImage.src = thumb.getAttribute('data-src');
        mainImage.srcset = thumb.getAttribute('data-srcset');
        mainImage.alt = thumb.getAttribute('data-alt') || '';
        thumbs.forEach(function (other) {
          other.classList.toggle('is-active', other === thumb);
        });
      });
    });

    var qtyInput = root.querySelector('[data-qty-input]');
    function stepQuantity(delta) {
      if (!qtyInput) return;
      var value = parseInt(qtyInput.value, 10) || 1;
      qtyInput.value = Math.max(1, value + delta);
    }

    var minusBtn = root.querySelector('[data-qty-minus]');
    var plusBtn = root.querySelector('[data-qty-plus]');
    if (minusBtn) minusBtn.addEventListener('click', function () { stepQuantity(-1); });
    if (plusBtn) plusBtn.addEventListener('click', function () { stepQuantity(1); });

    var form = root.querySelector('[data-product-form]');
    var addBtn = root.querySelector('[data-add-button]');
    var addLabel = root.querySelector('[data-add-label]');
    var priceEl = root.querySelector('[data-product-price]');
    var compareEl = root.querySelector('[data-product-compare]');
    var stockEl = root.querySelector('[data-product-stock]');
    var stockFill = root.querySelector('[data-stock-fill]');
    var stockLabel = root.querySelector('[data-stock-label]');
    var select = root.querySelector('[data-variant-select]');

    function renderStock(variant) {
      if (!stockEl || !stockFill || !stockLabel) return;
      if (!variant.tracked) {
        stockEl.hidden = true;
        return;
      }

      var qty = variant.qty;
      var percent = Math.min(80, Math.max(0, Math.min(qty, 20)) * 5);
      if (qty > 0) percent = Math.max(4, percent);

      var level = qty <= 0 ? 'low' : qty <= 20 ? 'medium' : 'high';
      var label = qty <= 0
        ? i18n.noStock
        : (qty <= 20 ? i18n.lowStock : i18n.inStock).replace('__COUNT__', qty);

      stockFill.style.width = percent + '%';
      stockFill.className = 'pdp__stock-fill pdp__stock-fill--' + level;
      stockLabel.textContent = label;
      stockEl.hidden = false;
    }

    function applyVariant(variant) {
      if (priceEl) priceEl.textContent = variant.price;
      if (compareEl) {
        compareEl.textContent = variant.compare || '';
        compareEl.hidden = !variant.compare;
      }
      if (addBtn) addBtn.disabled = !variant.available;
      if (addLabel) addLabel.textContent = variant.available ? i18n.addToCart : i18n.soldOut;
      renderStock(variant);
    }

    if (select) {
      select.addEventListener('change', function () {
        var match = variants.filter(function (variant) {
          return String(variant.id) === select.value;
        })[0];
        if (match) applyVariant(match);
      });
    }

    if (form && addBtn && addLabel) {
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        if (addBtn.disabled) return;

        var idField = form.elements['id'];
        var originalText = addLabel.textContent;
        addBtn.disabled = true;
        addLabel.textContent = i18n.adding;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            id: idField.value,
            quantity: qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1
          })
        })
          .then(function (response) {
            if (!response.ok) throw new Error('add_to_cart_failed');
            return fetch('/cart.js');
          })
          .then(function (response) { return response.json(); })
          .then(function (cart) {
            var cartCountEl = document.querySelector('.header__icons a[href*="/cart"] sup');
            if (cartCountEl) {
              cartCountEl.textContent = cart.item_count;
            } else if (cart.item_count > 0) {
              var cartLink = document.querySelector('.header__icons a[href*="/cart"]');
              if (cartLink) {
                var sup = document.createElement('sup');
                sup.textContent = cart.item_count;
                cartLink.insertBefore(sup, cartLink.firstChild);
              }
            }

            addBtn.classList.add('is-added');
            addLabel.textContent = i18n.added;

            setTimeout(function () {
              addBtn.classList.remove('is-added');
              addBtn.disabled = false;
              addLabel.textContent = originalText;
            }, 1500);
          })
          .catch(function () {
            addBtn.disabled = false;
            addLabel.textContent = originalText;
          });
      });
    }
  })();
{% endjavascript %}

