{% doc %}
  Renders the site footer: a full-width dark strip with a brand column
  (logo, short blurb, and contact details), a shop links column, a support
  links column, and a policies links column, followed by a bottom bar with
  the copyright notice and payment icons.

  When no navigation menu is assigned to `shop_menu`, `support_menu`, or
  `policies_menu`, a fixed set of links is rendered so each column is
  populated out of the box.

  @example
  {% section 'footer' %}
{% enddoc %}

{% liquid
  assign fallback_shop_titles = 'All Products|Steel Shelving|Steel Workbenches|MDF Shelving' | split: '|'
  assign fallback_shop_urls = '/collections/all|/collections/steel-shelving|/collections/steel-workbenches|/collections/mdf-shelving' | split: '|'
  assign fallback_support_titles = 'Contact Us|Assembly Instructions|Purchasing Guide|FAQs' | split: '|'
  assign fallback_support_urls = '/pages/contact-us|/pages/assembly-instructions|/pages/purchasing-guide|/pages/faq' | split: '|'
  assign fallback_info_titles = 'How To Collect In Your Vehicle|About Super Shelving|Share Your Experience' | split: '|'
  assign fallback_info_urls = '/pages/how-to-collect-in-your-vehicle|/pages/about-us|/pages/share-your-experience' | split: '|'
  assign fallback_policy_titles = 'Return Policy|Warranty Policy|Delivery Policy|Terms of Service' | split: '|'
  assign fallback_policy_urls = '/policies/refund-policy|/pages/warranty-policy|/pages/delivery-policy|/policies/terms-of-service' | split: '|'
%}

<footer class="footer full-width">
  <div class="footer__inner">
    <div class="footer__columns">
      <div class="footer__column footer__column--brand">
        {% liquid
          if section.settings.logo
            assign footer_logo_url = section.settings.logo | image_url: width: 300
          else
            assign footer_logo_url = 'logo.png' | asset_url
          endif
        %}
        <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }}">
          {% if section.settings.logo %}
            {{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: shop.name }}
          {% else %}
            <img src="{{ footer_logo_url }}" alt="{{ shop.name }}" loading="lazy">
          {% endif %}
          <span class="footer__logo-tm" aria-hidden="true">&trade;</span>
        </a>

        {% if section.settings.description != blank %}
          <p class="footer__description">{{ section.settings.description }}</p>
        {% endif %}

        <ul class="footer__list footer__list--contact">
          {% if section.settings.abn != blank %}
            <li>{{ 'labels.abn' | t }}: {{ section.settings.abn }}</li>
          {% endif %}

          {% if section.settings.address != blank %}
            <li>
              <span class="footer__contact-icon">{{ 'icon-pin.svg' | inline_asset_content }}</span>
              {{ section.settings.address }}
            </li>
          {% endif %}

          {% if section.settings.phone != blank %}
            <li>
              <span class="footer__contact-icon">{{ 'icon-phone.svg' | inline_asset_content }}</span>
              <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a>
            </li>
          {% endif %}

          {% if section.settings.email != blank %}
            <li>
              <span class="footer__contact-icon">{{ 'icon-mail.svg' | inline_asset_content }}</span>
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </li>
          {% endif %}
        </ul>
      </div>

      <div class="footer__column">
        <h3 class="footer__heading">{{ 'general.shop' | t }}</h3>
        <ul class="footer__list">
          {% if section.settings.shop_menu.links.size > 0 %}
            {% for link in section.settings.shop_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            {% for title in fallback_shop_titles %}
              <li><a href="{{ fallback_shop_urls[forloop.index0] }}">{{ title }}</a></li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>

      <div class="footer__column">
        <h3 class="footer__heading">{{ 'general.support' | t }}</h3>
        <ul class="footer__list">
          {% if section.settings.support_menu.links.size > 0 %}
            {% for link in section.settings.support_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            {% for title in fallback_support_titles %}
              <li><a href="{{ fallback_support_urls[forloop.index0] }}">{{ title }}</a></li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>

      <div class="footer__column">
        <h3 class="footer__heading">{{ 'general.info' | t }}</h3>
        <ul class="footer__list">
          {% if section.settings.info_menu.links.size > 0 %}
            {% for link in section.settings.info_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            {% for title in fallback_info_titles %}
              <li><a href="{{ fallback_info_urls[forloop.index0] }}">{{ title }}</a></li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>

      <div class="footer__column">
        <h3 class="footer__heading">{{ 'general.policies' | t }}</h3>
        <ul class="footer__list">
          {% if section.settings.policies_menu.links.size > 0 %}
            {% for link in section.settings.policies_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            {% for title in fallback_policy_titles %}
              <li><a href="{{ fallback_policy_urls[forloop.index0] }}">{{ title }}</a></li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}, {{ powered_by_link }}
      </div>

      {% if section.settings.show_payment_icons %}
        <div class="footer__payment">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    background-color: #1f2120;
    color: #e5e5e7;
  }

  .footer__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 3.5rem var(--page-margin) 2rem;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
    gap: 2rem;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .footer__logo img {
    display: block;
    width: auto;
    height: 1.75rem;
  }

  .footer__logo-tm {
    align-self: flex-start;
    margin-left: 0.2rem;
    font-size: 0.6rem;
    line-height: 1;
    color: #f5c02e;
  }

  .footer__description {
    margin: 1rem 0 0;
    max-width: 22rem;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.6;
    color: #a5a5a8;
  }

  .footer__heading {
    margin: 0 0 1.1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .footer__list a {
    color: #a5a5a8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__list a:hover {
    color: #ffffff;
  }

  .footer__list--contact {
    margin-top: 1.25rem;
  }

  .footer__list--contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: #a5a5a8;
    line-height: 1.5;
  }

  .footer__list--contact a {
    color: #a5a5a8;
  }

  .footer__list--contact a:hover {
    color: #ffffff;
  }

  .footer__contact-icon {
    flex: none;
    display: flex;
    margin-top: 0.15rem;
    color: #f5c02e;
    --icon-stroke-width: 1.6;
  }

  .footer__contact-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    color: #a5a5a8;
  }

  .footer__copyright {
    grid-column: 2;
    text-align: center;
  }

  .footer__copyright a {
    color: inherit;
    text-decoration: underline;
  }

  .footer__payment {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__payment svg {
    height: 1.25rem;
    width: auto;
  }

  @media screen and (max-width: 989px) {
    .footer__columns {
      grid-template-columns: 1fr 1fr;
      row-gap: 2.5rem;
    }
  }

  @media screen and (max-width: 590px) {
    .footer__columns {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .footer__copyright {
      grid-column: 1;
    }

    .footer__payment {
      grid-column: 1;
      justify-self: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Quality storage solutions for every space - homes, workshops, businesses & beyond."
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "t:labels.shop_menu"
    },
    {
      "type": "link_list",
      "id": "support_menu",
      "label": "t:labels.support_menu"
    },
    {
      "type": "link_list",
      "id": "info_menu",
      "label": "t:labels.info_menu"
    },
    {
      "type": "link_list",
      "id": "policies_menu",
      "label": "t:labels.policies_menu"
    },
    {
      "type": "text",
      "id": "abn",
      "label": "t:labels.abn"
    },
    {
      "type": "text",
      "id": "address",
      "label": "t:labels.address",
      "default": "Moonee Ponds, Melbourne VIC"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:labels.phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:labels.email"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
