{% doc %}
  Renders a before/after drag-to-reveal image comparison slider (cluttered
  floor vs. organised shelving) beside a heading, description and feature
  row (add, remove, or reorder `spotlight-feature` blocks in the theme
  editor) with a button.

  @example
  {% section 'before-after' %}
{% enddoc %}

<div class="before-after full-width">
  <div class="before-after__inner">
    <div class="before-after__intro">
      <div class="before-after__media" data-before-after>
        <div class="before-after__layer before-after__layer--after">
          {% if section.settings.after_image %}
            <img src="{{ section.settings.after_image | image_url: width: 800 }}" alt="After" loading="lazy">
          {% else %}
            <img src="{{ 'before-after-after.png' | asset_url }}" alt="After" loading="lazy">
          {% endif %}
          <span class="before-after__label before-after__label--after">After</span>
        </div>

        <div class="before-after__layer before-after__layer--before" data-before-after-before>
          {% if section.settings.before_image %}
            <img src="{{ section.settings.before_image | image_url: width: 800 }}" alt="Before" loading="lazy">
          {% else %}
            <img src="{{ 'before-after-before.png' | asset_url }}" alt="Before" loading="lazy">
          {% endif %}
          <span class="before-after__label before-after__label--before">Before</span>
        </div>

        <div class="before-after__handle" data-before-after-handle>
          <span class="before-after__handle-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 6l-6 6 6 6"></path>
            </svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 6l6 6-6 6"></path>
            </svg>
          </span>
        </div>
      </div>

      <div class="before-after__content">
        {% if section.settings.eyebrow != blank %}
          <span class="before-after__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="before-after__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="before-after__description">{{ section.settings.description }}</p>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <ul class="before-after__features">
            {% content_for 'blocks' %}
          </ul>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <div class="before-after__button-wrap">
            <a href="{{ section.settings.button_link | default: '#' }}" class="before-after__button">
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .before-after {
    padding: 4.5rem 0;
    background-color: #ffffff;
  }

  .before-after__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .before-after__intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: stretch;
  }

  .before-after__media {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 22rem;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #e5e5e7;
    user-select: none;
    -webkit-user-select: none;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .before-after__layer {
    position: absolute;
    inset: 0;
  }

  .before-after__layer--before {
    clip-path: inset(0 50% 0 0);
  }

  .before-after__layer img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .before-after__label {
    position: absolute;
    bottom: 0.75rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background-color: rgba(31, 33, 32, 0.75);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .before-after__label--before {
    left: 0.75rem;
  }

  .before-after__label--after {
    right: 0.75rem;
  }

  .before-after__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 3px;
    background-color: #ffffff;
    transform: translateX(-50%);
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.35);
  }

  .before-after__handle-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background-color: #ffffff;
    color: #1f2120;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .before-after__handle-btn svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .before-after__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }

  .before-after__eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6e;
  }

  .before-after__heading {
    margin: 0.6rem 0 0;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .before-after__description {
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #4a4a4d;
  }

  .before-after__features {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .before-after__button-wrap {
    text-align: left;
    margin-top: 2rem;
  }

  .before-after__button {
    display: inline-block;
    padding: 0.85rem 2.25rem;
    border: 1px solid #1f2120;
    border-radius: 999px;
    background-color: #1f2120;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: #ffffff;
    transition: filter 0.2s ease;
  }

  .before-after__button:hover {
    filter: brightness(1.3);
  }

  @media screen and (max-width: 749px) {
    .before-after__intro {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-before-after]').forEach(function (compare) {
    var before = compare.querySelector('[data-before-after-before]');
    var handle = compare.querySelector('[data-before-after-handle]');
    var dragging = false;

    function setPosition(percent) {
      percent = Math.min(100, Math.max(0, percent));
      before.style.clipPath = 'inset(0 ' + (100 - percent) + '% 0 0)';
      handle.style.left = percent + '%';
    }

    function positionFromEvent(event) {
      var rect = compare.getBoundingClientRect();
      var x = event.clientX - rect.left;
      return (x / rect.width) * 100;
    }

    function onPointerMove(event) {
      if (!dragging) return;
      setPosition(positionFromEvent(event));
    }

    function stopDragging() {
      dragging = false;
    }

    compare.addEventListener('pointerdown', function (event) {
      dragging = true;
      setPosition(positionFromEvent(event));
    });

    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', stopDragging);
    window.addEventListener('pointercancel', stopDragging);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.before_after",
  "blocks": [
    { "type": "spotlight-feature" }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "t:labels.before_image",
      "info": "t:labels.before_after_info"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "t:labels.after_image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Before & After"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Turn clutter into clear space"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "A messy garage or storeroom doesn't just look bad - it wastes the space you're paying for. The right shelving gets everything up off the floor and into its own spot, so nothing ends up in a pile and every inch of the room actually works for you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop Shelving"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.before_after",
      "blocks": [
        {
          "type": "spotlight-feature",
          "settings": {
            "icon": "box",
            "heading": "Reclaim your floor",
            "text": "Get boxes, tools and gear up off the ground and onto shelves where they belong."
          }
        },
        {
          "type": "spotlight-feature",
          "settings": {
            "icon": "layers",
            "heading": "Fit more into less",
            "text": "Vertical storage means you store more without needing a bigger space."
          }
        },
        {
          "type": "spotlight-feature",
          "settings": {
            "icon": "search",
            "heading": "Find things fast",
            "text": "Everything has its own spot, so you're not digging through piles to find what you need."
          }
        }
      ]
    }
  ]
}
{% endschema %}
