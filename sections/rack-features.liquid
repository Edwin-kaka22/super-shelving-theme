{% doc %}
  Renders a static "how it's built" diagram: a centred product photo with
  hotspot dots, connected by lines fanning out to labelled info boxes on
  the left and right. Purely presentational — no click interaction. Add,
  remove, or reorder `rack-feature` blocks in the theme editor; each one
  controls its own hotspot position, which side its box sits on, and the
  box's vertical position and text.

  @example
  {% section 'rack-features' %}
{% enddoc %}

<div class="rack-features full-width">
  <div class="rack-features__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <div class="rack-features__intro">
        {% if section.settings.eyebrow != blank %}
          <span class="rack-features__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="rack-features__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="rack-features__description">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="rack-features__diagram">
      <div class="rack-features__image">
        {% if section.settings.image %}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 990px) 30vw, 60vw"
            alt="{{ section.settings.image.alt | default: section.settings.heading }}"
            loading="lazy"
          >
        {% else %}
          <img
            src="{{ 'rack-main.png' | asset_url }}"
            alt="{{ section.settings.heading | default: 'Shelving rack' }}"
            loading="lazy"
          >
        {% endif %}
      </div>

      {% content_for 'blocks' %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: '#' }}" class="rack-features__button">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .rack-features {
    padding: 4rem 0;
    background-color: #f4f4f5;
  }

  .rack-features__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .rack-features__intro {
    max-width: 40rem;
    margin: 0 auto 1.25rem;
    text-align: center;
  }

  .rack-features__eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6e;
  }

  .rack-features__heading {
    margin: 0.6rem 0 0;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .rack-features__description {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #6b6b6e;
  }

  .rack-features__diagram {
    position: relative;
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    aspect-ratio: 4 / 3;
  }

  .rack-features__image {
    position: absolute;
    left: 22%;
    top: 3%;
    width: 56%;
    height: 74.67%;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #e5e5e7;
  }

  .rack-features__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rack-features__button {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 90%;
    transform: translateX(-50%);
    display: inline-block;
    padding: 0.85rem 2.25rem;
    border: 1px solid #1a1a1a;
    border-radius: 999px;
    background-color: #1a1a1a;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: #ffffff;
    transition: filter 0.2s ease;
  }

  .rack-features__button:hover {
    filter: brightness(1.3);
  }
{% endstylesheet %}

