{% doc %}
  Renders the in-depth product breakdown for the Purchasing Guide page: a
  centred heading and description above a stack of `guide-product` cards.

  @example
  {% section 'guide-products' %}
{% enddoc %}

<div class="guide-products full-width">
  <div class="guide-products__inner">
    <div class="guide-products__header">
      {% if section.settings.heading != blank %}
        <h2 class="guide-products__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="guide-products__description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="guide-products__list">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .guide-products {
    padding: 3rem 0;
    background-color: #ffffff;
  }

  .guide-products__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .guide-products__header {
    text-align: center;
  }

  .guide-products__heading {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .guide-products__description {
    max-width: 46rem;
    margin: 0.8rem auto 0;
    font-size: 1rem;
    line-height: 1.7;
    color: #4a4a4d;
  }

  .guide-products__list {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.guide_products",
  "blocks": [
    { "type": "guide-product" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "A closer look at each range"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description"
    }
  ],
  "presets": [
    {
      "name": "t:general.guide_products"
    }
  ]
}
{% endschema %}
