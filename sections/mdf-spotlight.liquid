{% doc %}
  Renders a product spotlight section for MDF shelving: a static lifestyle
  image beside a heading, description and feature row (add, remove, or
  reorder `spotlight-feature` blocks in the theme editor) with a button,
  followed by a full-width row of the 4 product size photos spread out
  beneath it.

  @example
  {% section 'mdf-spotlight' %}
{% enddoc %}

<div class="mdf-spotlight full-width">
  <div class="mdf-spotlight__inner">
    <div class="mdf-spotlight__intro">
      <div class="mdf-spotlight__placeholder">
        {% if section.settings.placeholder_image %}
          <img src="{{ section.settings.placeholder_image | image_url: width: 800 }}" alt="{{ section.settings.heading }}" loading="lazy">
        {% else %}
          <img src="{{ 'mdf-spotlight-placeholder.png' | asset_url }}" alt="{{ section.settings.heading | default: 'MDF shelving' }}" loading="lazy">
        {% endif %}
      </div>

      <div class="mdf-spotlight__intro-right">
        {% if section.settings.eyebrow != blank %}
          <span class="mdf-spotlight__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="mdf-spotlight__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="mdf-spotlight__description">{{ section.settings.description }}</p>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <ul class="mdf-spotlight__features">
            {% content_for 'blocks' %}
          </ul>
        {% endif %}
      </div>
    </div>

    <div class="mdf-spotlight__products">
      {% for i in (1..4) %}
        {% case i %}
          {% when 1 %}
            {% assign product_image = section.settings.image_1 %}
            {% assign product_caption = section.settings.caption_1 %}
            {% assign product_price = section.settings.price_1 %}
            {% assign product_link = section.settings.link_1 %}
            {% assign fallback_asset = 'mdf-shelf-150x70x30.png' %}
          {% when 2 %}
            {% assign product_image = section.settings.image_2 %}
            {% assign product_caption = section.settings.caption_2 %}
            {% assign product_price = section.settings.price_2 %}
            {% assign product_link = section.settings.link_2 %}
            {% assign fallback_asset = 'mdf-shelf-180x90x40.png' %}
          {% when 3 %}
            {% assign product_image = section.settings.image_3 %}
            {% assign product_caption = section.settings.caption_3 %}
            {% assign product_price = section.settings.price_3 %}
            {% assign product_link = section.settings.link_3 %}
            {% assign fallback_asset = 'mdf-shelf-180x120x45.png' %}
          {% when 4 %}
            {% assign product_image = section.settings.image_4 %}
            {% assign product_caption = section.settings.caption_4 %}
            {% assign product_price = section.settings.price_4 %}
            {% assign product_link = section.settings.link_4 %}
            {% assign fallback_asset = 'mdf-shelf-180x150x45.png' %}
        {% endcase %}

        {% if product_link != blank %}
          {% assign product_wrapper = 'a' %}
        {% else %}
          {% assign product_wrapper = 'div' %}
        {% endif %}

        <{{ product_wrapper }}
          class="mdf-spotlight__product"
          {% if product_link != blank %}
            href="{{ product_link }}"
          {% endif %}
        >
          <div class="mdf-spotlight__product-media">
            {% if product_image %}
              <img src="{{ product_image | image_url: width: 500 }}" alt="{{ product_caption }}" loading="lazy">
            {% else %}
              <img src="{{ fallback_asset | asset_url }}" alt="{{ product_caption }}" loading="lazy">
            {% endif %}
          </div>

          {% if product_caption != blank %}
            <span class="mdf-spotlight__product-caption">{{ product_caption }}</span>
          {% endif %}

          {% if product_price != blank %}
            <span class="mdf-spotlight__product-price">{{ product_price }}</span>
          {% endif %}
        </{{ product_wrapper }}>
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="mdf-spotlight__button-wrap">
        <a href="{{ section.settings.button_link | default: '#' }}" class="mdf-spotlight__button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .mdf-spotlight {
    padding: 4rem 0;
    background-color: #ffffff;
  }

  .mdf-spotlight__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .mdf-spotlight__intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: stretch;
  }

  .mdf-spotlight__intro-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }

  .mdf-spotlight__placeholder {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #f4f4f5;
    color: #9a9a9d;
  }

  .mdf-spotlight__placeholder img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mdf-spotlight__eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6e;
  }

  .mdf-spotlight__heading {
    margin: 0.6rem 0 0;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .mdf-spotlight__description {
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #4a4a4d;
  }

  .mdf-spotlight__features {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .mdf-spotlight__button-wrap {
    text-align: center;
    margin-top: 2.5rem;
  }

  .mdf-spotlight__button {
    display: inline-block;
    padding: 0.85rem 2.25rem;
    border: 1px solid #1f2120;
    border-radius: 999px;
    background-color: #1f2120;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: #ffffff;
    transition: filter 0.2s ease;
  }

  .mdf-spotlight__button:hover {
    filter: brightness(1.3);
  }

  .mdf-spotlight__products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: 3.5rem;
  }

  .mdf-spotlight__product {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .mdf-spotlight__product-media {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #f4f4f5;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mdf-spotlight__product-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mdf-spotlight__product:hover .mdf-spotlight__product-media {
    transform: translateY(-4px);
  }

  .mdf-spotlight__product-caption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
    text-align: center;
    color: #6b6b6e;
  }

  .mdf-spotlight__product-price {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    color: #1f2120;
  }

  @media screen and (max-width: 989px) {
    .mdf-spotlight__products {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .mdf-spotlight__intro {
      grid-template-columns: 1fr;
    }

    .mdf-spotlight__products {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

