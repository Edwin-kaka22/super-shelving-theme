{% doc %}
  Renders a product spotlight section for MDF shelving: a before/after
  drag-to-reveal image comparison slider (messy floor vs. organised shelf)
  beside a heading, description and feature row (add, remove, or reorder
  `spotlight-feature` blocks in the theme editor) with a button, followed
  by a full-width row of the 4 product size photos spread out beneath it.

  @example
  {% section 'mdf-spotlight' %}
{% enddoc %}

<div class="mdf-spotlight full-width">
  <div class="mdf-spotlight__inner">
    <div class="mdf-spotlight__intro">
      <div class="mdf-spotlight__placeholder mdf-compare" data-mdf-compare>
        <div class="mdf-compare__layer mdf-compare__layer--before">
          {% if section.settings.before_image %}
            <img src="{{ section.settings.before_image | image_url: width: 800 }}" alt="Before" loading="lazy">
          {% else %}
            <div class="mdf-compare__fallback">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                <circle cx="8.5" cy="9.5" r="1.5"></circle>
                <path d="M21 15l-5-5L5 21"></path>
              </svg>
            </div>
          {% endif %}
          <span class="mdf-compare__label mdf-compare__label--before">Before</span>
        </div>

        <div class="mdf-compare__layer mdf-compare__layer--after" data-mdf-compare-after>
          {% if section.settings.after_image %}
            <img src="{{ section.settings.after_image | image_url: width: 800 }}" alt="After" loading="lazy">
          {% else %}
            <img src="{{ 'mdf-spotlight-placeholder.png' | asset_url }}" alt="After" loading="lazy">
          {% endif %}
          <span class="mdf-compare__label mdf-compare__label--after">After</span>
        </div>

        <div class="mdf-compare__handle" data-mdf-compare-handle>
          <span class="mdf-compare__handle-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 6l-6 6 6 6"></path>
            </svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 6l6 6-6 6"></path>
            </svg>
          </span>
        </div>
      </div>

      <div class="mdf-spotlight__intro-right">
        {% if section.settings.eyebrow != blank %}
          <span class="mdf-spotlight__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="mdf-spotlight__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="mdf-spotlight__description">{{ section.settings.description }}</p>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <ul class="mdf-spotlight__features">
            {% content_for 'blocks' %}
          </ul>
        {% endif %}
      </div>
    </div>

    <div class="mdf-spotlight__products">
      {% for i in (1..4) %}
        {% case i %}
          {% when 1 %}
            {% assign product_image = section.settings.image_1 %}
            {% assign product_caption = section.settings.caption_1 %}
            {% assign product_price = section.settings.price_1 %}
            {% assign product_link = section.settings.link_1 %}
            {% assign fallback_asset = 'mdf-shelf-150x70x30.png' %}
          {% when 2 %}
            {% assign product_image = section.settings.image_2 %}
            {% assign product_caption = section.settings.caption_2 %}
            {% assign product_price = section.settings.price_2 %}
            {% assign product_link = section.settings.link_2 %}
            {% assign fallback_asset = 'mdf-shelf-180x90x40.png' %}
          {% when 3 %}
            {% assign product_image = section.settings.image_3 %}
            {% assign product_caption = section.settings.caption_3 %}
            {% assign product_price = section.settings.price_3 %}
            {% assign product_link = section.settings.link_3 %}
            {% assign fallback_asset = 'mdf-shelf-180x120x45.png' %}
          {% when 4 %}
            {% assign product_image = section.settings.image_4 %}
            {% assign product_caption = section.settings.caption_4 %}
            {% assign product_price = section.settings.price_4 %}
            {% assign product_link = section.settings.link_4 %}
            {% assign fallback_asset = 'mdf-shelf-180x150x45.png' %}
        {% endcase %}

        {% if product_link != blank %}
          {% assign product_wrapper = 'a' %}
        {% else %}
          {% assign product_wrapper = 'div' %}
        {% endif %}

        <{{ product_wrapper }}
          class="mdf-spotlight__product"
          {% if product_link != blank %}
            href="{{ product_link }}"
          {% endif %}
        >
          <div class="mdf-spotlight__product-media">
            {% if product_image %}
              <img src="{{ product_image | image_url: width: 500 }}" alt="{{ product_caption }}" loading="lazy">
            {% else %}
              <img src="{{ fallback_asset | asset_url }}" alt="{{ product_caption }}" loading="lazy">
            {% endif %}
          </div>

          {% if product_caption != blank %}
            <span class="mdf-spotlight__product-caption">{{ product_caption }}</span>
          {% endif %}

          {% if product_price != blank %}
            <span class="mdf-spotlight__product-price">{{ product_price }}</span>
          {% endif %}
        </{{ product_wrapper }}>
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="mdf-spotlight__button-wrap">
        <a href="{{ section.settings.button_link | default: '#' }}" class="mdf-spotlight__button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .mdf-spotlight {
    padding: 4rem 0;
    background-color: #ffffff;
  }

  .mdf-spotlight__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .mdf-spotlight__intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: stretch;
  }

  .mdf-spotlight__intro-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }

  .mdf-spotlight__placeholder {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #f4f4f5;
    color: #9a9a9d;
  }

  .mdf-compare {
    position: relative;
    user-select: none;
    -webkit-user-select: none;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .mdf-compare__layer {
    position: absolute;
    inset: 0;
  }

  .mdf-compare__layer--after {
    clip-path: inset(0 50% 0 0);
  }

  .mdf-compare__layer img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .mdf-compare__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: #e5e5e7;
    color: #9a9a9d;
  }

  .mdf-compare__fallback svg {
    width: 2.5rem;
    height: 2.5rem;
  }

  .mdf-compare__label {
    position: absolute;
    top: 0.75rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background-color: rgba(31, 33, 32, 0.75);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mdf-compare__label--before {
    left: 0.75rem;
  }

  .mdf-compare__label--after {
    right: 0.75rem;
  }

  .mdf-compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 3px;
    background-color: #ffffff;
    transform: translateX(-50%);
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.35);
  }

  .mdf-compare__handle-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background-color: #ffffff;
    color: #1f2120;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .mdf-compare__handle-btn svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .mdf-spotlight__eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6e;
  }

  .mdf-spotlight__heading {
    margin: 0.6rem 0 0;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .mdf-spotlight__description {
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #4a4a4d;
  }

  .mdf-spotlight__features {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .mdf-spotlight__button-wrap {
    text-align: center;
    margin-top: 2.5rem;
  }

  .mdf-spotlight__button {
    display: inline-block;
    padding: 0.85rem 2.25rem;
    border: 1px solid #1f2120;
    border-radius: 999px;
    background-color: #1f2120;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: #ffffff;
    transition: filter 0.2s ease;
  }

  .mdf-spotlight__button:hover {
    filter: brightness(1.3);
  }

  .mdf-spotlight__products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: 3.5rem;
  }

  .mdf-spotlight__product {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .mdf-spotlight__product-media {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #f4f4f5;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mdf-spotlight__product-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mdf-spotlight__product:hover .mdf-spotlight__product-media {
    transform: translateY(-4px);
  }

  .mdf-spotlight__product-caption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
    text-align: center;
    color: #6b6b6e;
  }

  .mdf-spotlight__product-price {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    color: #1f2120;
  }

  @media screen and (max-width: 989px) {
    .mdf-spotlight__products {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .mdf-spotlight__intro {
      grid-template-columns: 1fr;
    }

    .mdf-spotlight__products {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-mdf-compare]').forEach(function (compare) {
    var after = compare.querySelector('[data-mdf-compare-after]');
    var handle = compare.querySelector('[data-mdf-compare-handle]');
    var dragging = false;

    function setPosition(percent) {
      percent = Math.min(100, Math.max(0, percent));
      after.style.clipPath = 'inset(0 ' + (100 - percent) + '% 0 0)';
      handle.style.left = percent + '%';
    }

    function positionFromEvent(event) {
      var rect = compare.getBoundingClientRect();
      var x = event.clientX - rect.left;
      return (x / rect.width) * 100;
    }

    function onPointerMove(event) {
      if (!dragging) return;
      setPosition(positionFromEvent(event));
    }

    function stopDragging() {
      dragging = false;
    }

    compare.addEventListener('pointerdown', function (event) {
      dragging = true;
      setPosition(positionFromEvent(event));
    });

    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', stopDragging);
    window.addEventListener('pointercancel', stopDragging);
  });
{% endjavascript %}

