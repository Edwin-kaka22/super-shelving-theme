{% doc %}
  Renders the standalone /search page: a page-level field to refine the
  query, and a grid of matching products styled with the same product-card
  snippet used on collection pages. Non-product results (articles, pages)
  render as simple linked cards.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search

  @example
  {% section 'search' %}
{% enddoc %}

<div class="search-page">
  <h1 class="search-page__heading">
    {% if search.performed %}
      {% if search.results_count > 0 %}
        {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
      {% else %}
        {{ 'search.no_results_html' | t: terms: search.terms }}
      {% endif %}
    {% else %}
      {{ 'search.title' | t }}
    {% endif %}
  </h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <input
      type="search"
      name="q"
      class="search-page__input"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      aria-label="{{ 'search.title' | t }}"
    >
    <button type="submit" class="search-page__submit">{{ 'search.submit' | t }}</button>
  </form>

  {% if search.performed and search.results_count > 0 %}
    {% paginate search.results by 24 %}
      <div class="search-page__grid">
        {% for result in search.results %}
          {% if result.object_type == 'product' %}
            {% render 'product-card', product: result %}
          {% else %}
            <a href="{{ result.url }}" class="search-page__result">
              {% assign result_image = result.featured_image | default: result.image %}
              {% if result_image %}
                <img
                  src="{{ result_image | image_url: width: 400 }}"
                  alt="{{ result.title | escape }}"
                  loading="lazy"
                  width="{{ result_image.width }}"
                  height="{{ result_image.height }}"
                >
              {% endif %}
              <span class="search-page__result-title">{{ result.title }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <div class="search-page__pagination">
        {{ paginate | default_pagination }}
      </div>
    {% endpaginate %}
  {% endif %}
</div>

{% stylesheet %}
  .search-page {
    padding: 3rem 0 5rem;
  }

  .search-page__heading {
    margin: 0 0 1.5rem;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .search-page__form {
    display: flex;
    gap: 0.75rem;
    max-width: 30rem;
    margin-bottom: 2.5rem;
  }

  .search-page__input {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 1.1rem;
    border: 1px solid #e5e5e7;
    border-radius: 999px;
    font-size: 0.9rem;
    color: #1f2120;
  }

  .search-page__input:focus-visible {
    outline: 2px solid #1f2120;
    outline-offset: 2px;
  }

  .search-page__submit {
    flex: none;
    padding: 0.8rem 1.75rem;
    border: 1px solid #1f2120;
    border-radius: 999px;
    background-color: #1f2120;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .search-page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2.5rem 1.5rem;
  }

  .search-page__result {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: 0.75rem;
    background-color: #f4f4f5;
    color: #1f2120;
    text-decoration: none;
    text-align: center;
  }

  .search-page__result img {
    width: 100%;
    max-width: 8rem;
    height: auto;
    border-radius: 0.5rem;
  }

  .search-page__result-title {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .search-page__pagination {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  @media screen and (max-width: 749px) {
    .search-page__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1rem;
    }

    .search-page__form {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
