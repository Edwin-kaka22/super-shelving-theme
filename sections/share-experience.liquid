{% doc %}
  Renders the Share Your Experience page: an intro, a trust stats row, a
  two-step "Leave a Google Review / Submit Your Photos" panel, and (as a
  secondary option) a review-submission form built on Shopify's native
  contact form.

  Form submissions are emailed to the store's customer contact email and
  are visible in Shopify admin under Settings > Notifications, the same
  as the Contact Us page's form.

  Shopify's built-in contact form can't reliably deliver file attachments
  without a third-party app, so photo submissions are routed to an
  external photo-upload link (e.g. a free Google Form, which does support
  file uploads) instead of a file input field that would silently fail to
  send. Until a merchant sets that link, a "email us a photo" note shows
  instead.

  @example
  {% section 'share-experience' %}
{% enddoc %}

<div class="share-experience full-width">
  <div class="share-experience__inner">
    <div class="share-experience__header">
      {% if section.settings.eyebrow != blank %}
        <span class="share-experience__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="share-experience__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="share-experience__description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="share-experience__stats">
      <div class="share-experience__stat">
        <span class="share-experience__stat-value share-experience__stat-value--rating">
          {{ section.settings.rating_value }}
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.59 5.25 5.79.84-4.19 4.09.99 5.77L10 14.77l-5.18 2.68.99-5.77-4.19-4.09 5.79-.84L10 1.5z"/></svg>
        </span>
        <span class="share-experience__stat-label">{{ 'share_experience.stats.rating' | t }}</span>
      </div>
      <div class="share-experience__stat">
        <span class="share-experience__stat-value">{{ 'share_experience.stats.customers_value' | t }}</span>
        <span class="share-experience__stat-label">{{ 'share_experience.stats.customers_label' | t }}</span>
      </div>
      <div class="share-experience__stat">
        <span class="share-experience__stat-value">{{ 'share_experience.stats.delivery_value' | t }}</span>
        <span class="share-experience__stat-label">{{ 'share_experience.stats.delivery_label' | t }}</span>
      </div>
      <div class="share-experience__stat">
        <span class="share-experience__stat-value">{{ 'share_experience.stats.warranty_value' | t }}</span>
        <span class="share-experience__stat-label">{{ 'share_experience.stats.warranty_label' | t }}</span>
      </div>
    </div>

    <div class="share-experience__layout">
      <div class="share-experience__trusted-card">
        <div class="share-experience__trusted-stars" aria-hidden="true">
          {% for i in (1..5) %}
            <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.59 5.25 5.79.84-4.19 4.09.99 5.77L10 14.77l-5.18 2.68.99-5.77-4.19-4.09 5.79-.84L10 1.5z"/></svg>
          {% endfor %}
        </div>

        {% if section.settings.trusted_heading != blank %}
          <h2 class="share-experience__trusted-heading">{{ section.settings.trusted_heading }}</h2>
        {% endif %}

        {% if section.settings.trusted_text != blank %}
          <p class="share-experience__trusted-text">{{ section.settings.trusted_text }}</p>
        {% endif %}

        {% capture newline %}
{% endcapture %}
        {% assign trusted_points = section.settings.trusted_points | split: newline %}
        <ul class="share-experience__trusted-points">
          {% for point in trusted_points %}
            {% assign point_text = point | strip %}
            {% if point_text != blank %}
              <li>{{ point_text }}</li>
            {% endif %}
          {% endfor %}
        </ul>

        {% if section.settings.trusted_quote != blank %}
          <figure class="share-experience__trusted-quote">
            <blockquote>&ldquo;{{ section.settings.trusted_quote }}&rdquo;</blockquote>
            {% if section.settings.trusted_quote_author != blank %}
              <figcaption>{{ section.settings.trusted_quote_author }}</figcaption>
            {% endif %}
          </figure>
        {% endif %}
      </div>

      <div class="share-experience__panel">
      {% if section.settings.share_heading != blank %}
        <h2 class="share-experience__panel-heading">{{ section.settings.share_heading }}</h2>
      {% endif %}

      {% if section.settings.share_description != blank %}
        <p class="share-experience__panel-description">{{ section.settings.share_description }}</p>
      {% endif %}

      <div class="share-experience__steps">
        <div class="share-experience__step">
          <span class="share-experience__step-number">{{ 'share_experience.steps.step_1_label' | t }}</span>
          <h3 class="share-experience__step-heading">{{ section.settings.step_1_heading }}</h3>
          <p class="share-experience__step-text">{{ section.settings.step_1_text }}</p>
          <a href="{{ section.settings.google_link | default: '#' }}" class="share-experience__step-button" target="_blank" rel="noopener">
            {{ section.settings.step_1_button_label }}
          </a>
        </div>

        <div class="share-experience__step">
          <span class="share-experience__step-number">{{ 'share_experience.steps.step_2_label' | t }}</span>
          <h3 class="share-experience__step-heading">{{ section.settings.step_2_heading }}</h3>
          <p class="share-experience__step-text">{{ section.settings.step_2_text }}</p>

          {% if section.settings.photo_form_link != blank %}
            <a href="{{ section.settings.photo_form_link }}" class="share-experience__step-button" target="_blank" rel="noopener">
              {{ section.settings.step_2_button_label }}
            </a>
          {% elsif section.settings.photo_email != blank %}
            <p class="share-experience__step-fallback">
              {{ 'share_experience.form.photo_note_html' | t: email: section.settings.photo_email }}
            </p>
          {% endif %}
        </div>
      </div>

      <ul class="share-experience__tags">
        <li>{{ 'share_experience.tags.home' | t }}</li>
        <li>{{ 'share_experience.tags.garage' | t }}</li>
        <li>{{ 'share_experience.tags.workshop' | t }}</li>
        <li>{{ 'share_experience.tags.business' | t }}</li>
        <li>{{ 'share_experience.tags.warehouse' | t }}</li>
      </ul>
      </div>
    </div>

    <div class="share-experience__form-wrap">
      {% if section.settings.form_heading != blank %}
        <h2 class="share-experience__form-heading">{{ section.settings.form_heading }}</h2>
      {% endif %}

      {% form 'contact', class: 'share-experience__form' %}
        {% if form.posted_successfully? %}
          <p class="share-experience__success" role="status">{{ 'share_experience.form.success' | t }}</p>
        {% endif %}

        {% if form.errors %}
          <div class="share-experience__errors" role="alert">
            <p class="share-experience__errors-heading">{{ 'share_experience.form.error_heading' | t }}</p>
            <ul>
              {% for field in form.errors %}
                <li>
                  {% if field == 'form' %}
                    {{ form.errors.messages[field] }}
                  {% else %}
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        <input type="hidden" name="contact[tags]" value="review-submission">

        <div class="share-experience__field">
          <label for="ShareExperienceName">{{ 'contact.form.name' | t }}</label>
          <input
            type="text"
            id="ShareExperienceName"
            name="contact[name]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            autocomplete="name"
            required
          >
        </div>

        <div class="share-experience__field">
          <label for="ShareExperienceEmail">{{ 'contact.form.email' | t }}</label>
          <input
            type="email"
            id="ShareExperienceEmail"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            autocomplete="email"
            autocapitalize="off"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
            {% endif %}
          >
        </div>

        <div class="share-experience__field">
          <label for="ShareExperienceOrder">{{ 'share_experience.form.order_number' | t }}</label>
          <input
            type="text"
            id="ShareExperienceOrder"
            name="contact[order_number]"
            value="{{ form.order_number }}"
          >
        </div>

        <div class="share-experience__field">
          <label for="ShareExperienceRating">{{ 'share_experience.form.rating' | t }}</label>
          <select id="ShareExperienceRating" name="contact[rating]" required>
            <option value="" selected disabled>{{ 'share_experience.form.rating' | t }}</option>
            <option value="5">{{ 'share_experience.form.rating_5' | t }}</option>
            <option value="4">{{ 'share_experience.form.rating_4' | t }}</option>
            <option value="3">{{ 'share_experience.form.rating_3' | t }}</option>
            <option value="2">{{ 'share_experience.form.rating_2' | t }}</option>
            <option value="1">{{ 'share_experience.form.rating_1' | t }}</option>
          </select>
        </div>

        <div class="share-experience__field">
          <label for="ShareExperienceReview">{{ 'share_experience.form.review' | t }}</label>
          <textarea id="ShareExperienceReview" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="share-experience__submit">
          <span data-submit-label>{{ 'share_experience.form.submit' | t }}</span>
        </button>
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .share-experience {
    padding: 4.5rem 0;
    background-color: #ffffff;
  }

  .share-experience__inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .share-experience__header {
    margin: 0 auto;
    text-align: center;
  }

  .share-experience__eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6e;
  }

  .share-experience__heading {
    margin: 0.6rem 0 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .share-experience__description {
    max-width: 40rem;
    margin: 0.9rem auto 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #4a4a4d;
  }

  .share-experience__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin: 2.75rem 0 0;
    padding: 1.5rem 0;
    border-top: 1px solid #e5e5e7;
    border-bottom: 1px solid #e5e5e7;
  }

  .share-experience__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    text-align: center;
  }

  .share-experience__stat-value {
    font-size: 1.4rem;
    font-weight: 800;
    color: #1f2120;
  }

  .share-experience__stat-value--rating {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .share-experience__stat-value--rating svg {
    width: 1.2rem;
    height: 1.2rem;
    color: #1f2120;
  }

  .share-experience__stat-label {
    font-size: 0.75rem;
    color: #6b6b6e;
  }

  .share-experience__layout {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 2.75rem 0 0;
  }

  .share-experience__layout > .share-experience__panel {
    order: 1;
  }

  .share-experience__layout > .share-experience__trusted-card {
    order: 2;
  }

  .share-experience__trusted-card {
    padding: 1.75rem;
    border: 1px solid #e5e5e7;
    border-radius: 0.75rem;
    background-color: #ffffff;
  }

  .share-experience__trusted-stars {
    display: flex;
    gap: 0.2rem;
    color: #f5c02e;
  }

  .share-experience__trusted-stars svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .share-experience__trusted-heading {
    margin: 1rem 0 0;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .share-experience__trusted-text {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: #6b6b6e;
  }

  .share-experience__trusted-points {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .share-experience__trusted-points li {
    padding: 0.65rem 0.9rem;
    border-radius: 0.6rem;
    background-color: #f4f4f5;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: #1f2120;
  }

  .share-experience__trusted-quote {
    margin: 1.25rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid #e5e5e7;
  }

  .share-experience__trusted-quote blockquote {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    font-style: italic;
    color: #4a4a4d;
  }

  .share-experience__trusted-quote figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #1f2120;
  }

  .share-experience__panel {
    margin: 0;
    padding: 2rem;
    border-radius: 0.75rem;
    background-color: #f4f4f5;
    text-align: center;
  }

  .share-experience__panel-heading {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .share-experience__panel-description {
    margin: 0.6rem auto 0;
    max-width: 32rem;
    font-size: 0.95rem;
    color: #6b6b6e;
  }

  .share-experience__steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
    text-align: left;
  }

  .share-experience__step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.5rem;
    border-radius: 0.6rem;
    background-color: #ffffff;
  }

  .share-experience__step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    height: 1.75rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    background-color: #f5c02e;
    color: #1a1a1a;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .share-experience__step-heading {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1f2120;
  }

  .share-experience__step-text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #6b6b6e;
  }

  .share-experience__step-button {
    display: inline-block;
    margin-top: 0.25rem;
    padding: 0.65rem 1.5rem;
    border: 1px solid #1f2120;
    border-radius: 999px;
    background-color: #1f2120;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .share-experience__step-button:hover {
    background-color: #52564f;
  }

  .share-experience__step-fallback {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #6b6b6e;
  }

  .share-experience__step-fallback a {
    color: #1f2120;
    text-decoration: underline;
  }

  .share-experience__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .share-experience__tags li {
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background-color: #ffffff;
    border: 1px solid #e5e5e7;
    font-size: 0.8rem;
    font-weight: 600;
    color: #1f2120;
  }

  .share-experience__form-wrap {
    margin: 3rem auto 0;
  }

  .share-experience__form-heading {
    margin: 0 0 1.5rem;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-align: center;
    color: #1f2120;
  }

  .share-experience__form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .share-experience__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .share-experience__field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #1f2120;
  }

  .share-experience__field input,
  .share-experience__field select,
  .share-experience__field textarea {
    padding: 0.8rem 1rem;
    border: 1px solid #e5e5e7;
    background-color: #ffffff;
    font-size: 0.95rem;
    font-family: inherit;
    color: #1f2120;
  }

  .share-experience__field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .share-experience__field input:focus-visible,
  .share-experience__field select:focus-visible,
  .share-experience__field textarea:focus-visible {
    outline: 2px solid #1f2120;
    outline-offset: 2px;
  }

  .share-experience__submit {
    position: relative;
    align-self: flex-start;
    overflow: hidden;
    margin-top: 0.5rem;
    padding: 0.9rem 2.25rem;
    border: 1px solid #1f2120;
    border-radius: 999px;
    background-color: #1f2120;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .share-experience__submit::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: #52564f;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .share-experience__submit:hover::before {
    transform: scaleX(1);
  }

  .share-experience__submit:hover {
    border-color: #52564f;
  }

  .share-experience__submit [data-submit-label] {
    position: relative;
    z-index: 1;
  }

  .share-experience__success {
    padding: 0.9rem 1.1rem;
    background-color: #eef7ee;
    border: 1px solid #bfe3bf;
    border-radius: 0.6rem;
    color: #1f5c1f;
    font-size: 0.9rem;
  }

  .share-experience__errors {
    padding: 0.9rem 1.1rem;
    background-color: #fdecec;
    border: 1px solid #f3b8b8;
    border-radius: 0.6rem;
    color: #8a1f1f;
    font-size: 0.9rem;
  }

  .share-experience__errors-heading {
    margin: 0 0 0.4rem;
    font-weight: 700;
  }

  .share-experience__errors ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  @media screen and (min-width: 750px) {
    .share-experience__heading {
      white-space: nowrap;
    }
  }

  @media screen and (max-width: 989px) {
    .share-experience__trusted-points {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .share-experience__stats {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1.5rem;
    }

    .share-experience__steps {
      grid-template-columns: 1fr;
    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.share_experience",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Share Your Experience"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Show Us Your Storage Transformation!"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "We would love to see how you have transformed your Home, Garage, Workshop or Warehouse using our products."
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "t:labels.rating_value",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "trusted_heading",
      "label": "t:labels.trusted_heading",
      "default": "Trusted Across Victorian Homes & Businesses"
    },
    {
      "type": "textarea",
      "id": "trusted_text",
      "label": "t:labels.trusted_text",
      "default": "Built for garages, workshops, warehouses and commercial storage spaces."
    },
    {
      "type": "textarea",
      "id": "trusted_points",
      "label": "t:labels.trusted_points",
      "info": "t:labels.trusted_points_info",
      "default": "Victoria Wide Delivery\nHeavy Duty Storage Systems\nGarage & Warehouse Solutions\nFull 12 Months Warranty"
    },
    {
      "type": "textarea",
      "id": "trusted_quote",
      "label": "t:labels.trusted_quote",
      "default": "Great value for money and really sturdy once assembled. Would definitely buy from Super Shelving again."
    },
    {
      "type": "text",
      "id": "trusted_quote_author",
      "label": "t:labels.trusted_quote_author",
      "default": "James T., Customer Review"
    },
    {
      "type": "text",
      "id": "share_heading",
      "label": "t:labels.share_heading",
      "default": "Share Your Setup"
    },
    {
      "type": "textarea",
      "id": "share_description",
      "label": "t:labels.share_description",
      "default": "Leave a Google review and share photos of your Super Shelving setup - we love seeing how you've put your space together."
    },
    {
      "type": "text",
      "id": "step_1_heading",
      "label": "t:labels.step_1_heading",
      "default": "Leave A Google Review"
    },
    {
      "type": "textarea",
      "id": "step_1_text",
      "label": "t:labels.step_1_text",
      "default": "Tell us about your shelving, workbench, or storage setup experience."
    },
    {
      "type": "text",
      "id": "step_1_button_label",
      "label": "t:labels.button_label",
      "default": "Leave A Review"
    },
    {
      "type": "url",
      "id": "google_link",
      "label": "t:labels.google_link"
    },
    {
      "type": "text",
      "id": "step_2_heading",
      "label": "t:labels.step_2_heading",
      "default": "Submit Your Photos"
    },
    {
      "type": "textarea",
      "id": "step_2_text",
      "label": "t:labels.step_2_text",
      "default": "Share photos of your finished setup, garage, workshop or warehouse."
    },
