{% doc %}
  Renders the site header: a full-width dark strip with the logo on the left,
  flat nav links next to it, and search, account and cart icons on the right.

  Until a merchant uploads their own logo, `logo.png` is used so the header
  always renders with content.

  When no navigation menu is assigned, a fixed set of 6 links is rendered so
  the nav is populated out of the box. Assigning a menu in the theme editor
  overrides that fallback.

  @example
  {% section 'header' %}
{% enddoc %}

{% liquid
  assign fallback_titles = 'All Products|Steel Shelving|Steel Workbenches|MDF Shelving|Contact Us|Assembly Instructions' | split: '|'
  assign fallback_urls = '/collections/all|/collections/steel-shelving-racks|/collections/steel-workbenches|/collections/mdf-shelving-racks|/pages/contact|/pages/assembly-instructions' | split: '|'
%}

<header class="header full-width" style="--header-background: {{ section.settings.background_color }}">
  <div class="header__inner">
    {% liquid
      if section.settings.logo
        assign logo_url = section.settings.logo | image_url: width: 300
      else
        assign logo_url = 'logo.png' | asset_url
      endif
    %}
    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }}">
      <span class="header__logo-media">
        {% if section.settings.logo %}
          {{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'eager', alt: shop.name }}
        {% else %}
          <img src="{{ logo_url }}" alt="{{ shop.name }}" width="1331" height="148" loading="eager">
        {% endif %}
        <span class="header__logo-shine" data-logo-shine="{{ logo_url }}" style="--logo-mask: url('{{ logo_url }}');"></span>
      </span>
    </a>

    <nav class="header__nav">
      {% if section.settings.menu.links.size > 0 %}
        {% for link in section.settings.menu.links %}
          {%- liquid
            assign link_url = link.url
            if link.title == 'Assembly Instructions' and link.url == routes.root_url
              assign link_url = routes.root_url | append: 'pages/assembly-instructions'
            endif
          -%}
          <a href="{{ link_url }}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        {% for title in fallback_titles %}
          <a href="{{ fallback_urls[forloop.index0] }}">{{ title }}</a>
        {% endfor %}
      {% endif %}
    </nav>

    <div class="header__icons">
      <a href="{{ routes.search_url }}" class="header__icon-search" data-search-drawer-toggle aria-label="{{ 'search.title' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>

      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a href="{{ routes.cart_url }}" data-cart-drawer-toggle>
        {% if cart.item_count > 0 %}
          <sup>{{ cart.item_count }}</sup>
        {% endif %}

        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    position: relative;
    background-color: var(--header-background);
    color: #ffffff;
  }

  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 5rem;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .header__logo {
    display: flex;
    flex: none;
    align-items: center;
    /* Pull left by up to 4.5rem, but never past 1.75rem from the screen edge */
    margin-left: calc(-1 * min(4.5rem, max(0px, var(--page-margin) + max(0px, (100vw - var(--page-width)) / 2) - 1.75rem)));
    color: inherit;
    text-decoration: none;
  }

  .header__logo-media {
    position: relative;
    display: block;
    line-height: 0;
  }

  .header__logo img {
    display: block;
    width: auto;
    height: 2rem;
  }

  .header__logo-shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(100deg, rgba(255, 255, 255, 0) 37%, rgba(255, 255, 255, 1) 49%, rgba(255, 255, 255, 1) 51%, rgba(255, 255, 255, 0) 63%);
    background-size: 300% 100%;
    background-position: 100% 0;
    background-repeat: no-repeat;
    -webkit-mask-image: var(--logo-mask);
    mask-image: var(--logo-mask);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    /* Hidden until the logo mask has loaded; without it the shine is a plain
       white rectangle over the logo. */
    visibility: hidden;
  }

  .header__logo-shine.is-ready {
    visibility: visible;
    animation: header-logo-shine 0.8s linear 0.3s 2;
  }

  @keyframes header-logo-shine {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__logo-shine.is-ready {
      animation: none;
    }
  }

  .header__nav {
    position: absolute;
    left: calc(50% + 1.5rem);
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.25rem;
  }

  .header__nav a {
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .header__nav a:hover {
    text-decoration: underline;
  }

  .header__icons {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.75rem;
    margin-right: calc(-1 * min(2.5rem, max(0px, var(--page-margin) + max(0px, (100vw - var(--page-width)) / 2) - 1.75rem)));
    --icon-stroke-width: 1.75;
  }

  .header__icons a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    text-decoration: none;
  }

  .header__icon-search {
    margin-right: -0.35rem;
  }

  .header__icons svg {
    width: 1.35rem;
  }

  .header__icons a sup {
    position: absolute;
    top: -0.25rem;
    right: -0.5rem;
    min-width: 1rem;
    height: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.2rem;
    border-radius: 999px;
    background-color: #f5c02e;
    color: #1a1a1a;
    font-size: 0.65rem;
  }
{% endstylesheet %}

{% javascript %}
  // Start the shine only once the logo file is loaded, so the mask is ready
  // and the effect never shows as a plain rectangle.
  document.querySelectorAll('[data-logo-shine]').forEach(function (shine) {
    var logo = new Image();
    var start = function () {
      shine.classList.add('is-ready');
    };
    logo.onload = start;
    logo.src = shine.getAttribute('data-logo-shine');
    if (logo.complete && logo.naturalWidth) start();
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#1f2120"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
