{% doc %}
  Renders the top of the Purchasing Guide page: a centred heading and
  introduction, an optional "rule of thumb" callout, then a row of
  `guide-choice` cards (one per product type) that help a customer decide
  which range suits them.

  @example
  {% section 'purchasing-guide' %}
{% enddoc %}

<div class="purchasing-guide full-width">
  <div class="purchasing-guide__inner">
    <div class="purchasing-guide__header">
      {% if section.settings.eyebrow != blank %}
        <span class="purchasing-guide__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="purchasing-guide__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="purchasing-guide__description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    {% if section.settings.tip_text != blank %}
      <div class="purchasing-guide__tip">
        {% if section.settings.tip_heading != blank %}
          <h2 class="purchasing-guide__tip-heading">{{ section.settings.tip_heading }}</h2>
        {% endif %}
        <p class="purchasing-guide__tip-text">{{ section.settings.tip_text }}</p>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="purchasing-guide__choices">
        {% content_for 'blocks' %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .purchasing-guide {
    padding: 4.5rem 0 2rem;
    background-color: #ffffff;
  }

  .purchasing-guide__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .purchasing-guide__header {
    text-align: center;
  }

  .purchasing-guide__eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6e;
  }

  .purchasing-guide__heading {
    margin: 0.6rem 0 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .purchasing-guide__description {
    max-width: 66rem;
    margin: 0.9rem auto 0;
    font-size: 1rem;
    line-height: 1.7;
    color: #4a4a4d;
  }

  .purchasing-guide__tip {
    max-width: 66rem;
    margin: 2.25rem auto 0;
    padding: 1.5rem 2rem;
    border-radius: 1rem;
    background-color: #f4f4f5;
    text-align: center;
  }

  .purchasing-guide__tip-heading {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .purchasing-guide__tip-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #4a4a4d;
  }

  .purchasing-guide__choices {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .purchasing-guide__choices > * {
    display: flex;
  }

  .purchasing-guide__choices > * > .guide-choice {
    flex: 1;
    min-width: 0;
  }

  @media screen and (max-width: 989px) {
    .purchasing-guide__choices {
      grid-template-columns: 1fr;
      max-width: 34rem;
      margin-right: auto;
      margin-left: auto;
    }
  }

  @media screen and (max-width: 589px) {
    .purchasing-guide__tip {
      padding: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.purchasing_guide",
  "blocks": [
    { "type": "guide-choice" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Buying Guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Purchasing Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "text",
      "id": "tip_heading",
      "label": "t:labels.tip_heading"
    },
    {
      "type": "textarea",
      "id": "tip_text",
      "label": "t:labels.tip_text"
    }
  ],
  "presets": [
    {
      "name": "t:general.purchasing_guide"
    }
  ]
}
{% endschema %}
