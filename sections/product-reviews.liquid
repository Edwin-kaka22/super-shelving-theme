{% doc %}
  Renders a product reviews area: a centred heading and optional intro, with
  a slot for a reviews app widget (Judge.me, Loox, Okendo, etc.). Add the
  app's review widget block inside this section in the theme editor.

  Nothing is shown on the storefront until at least one block has been added,
  so an empty heading never appears on its own. In the theme editor, a hint
  is shown instead.

  @example
  {% section 'product-reviews' %}
{% enddoc %}

{% if section.blocks.size > 0 %}
  <div class="product-reviews full-width" id="product-reviews">
    <div class="product-reviews__inner">
      {% if section.settings.heading != blank %}
        <h2 class="product-reviews__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="product-reviews__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      <div class="product-reviews__widget">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
{% elsif request.design_mode %}
  <div class="product-reviews full-width">
    <div class="product-reviews__inner">
      <p class="product-reviews__hint">{{ 'product_reviews.editor_hint' | t }}</p>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .product-reviews {
    padding: 4rem 0;
    background-color: #ffffff;
    --page-width: 103rem;
  }

  .product-reviews__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .product-reviews__heading {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-align: center;
    text-transform: uppercase;
    color: #1f2120;
  }

  .product-reviews__subheading {
    margin: 0.75rem auto 0;
    max-width: 36rem;
    text-align: center;
    font-size: 0.95rem;
    color: #6b6b6e;
    text-wrap: balance;
  }

  .product-reviews__widget {
    margin-top: 2.5rem;
  }

  .product-reviews__hint {
    margin: 0;
    padding: 1.5rem;
    border: 1px dashed #c9c9cd;
    border-radius: 0.75rem;
    text-align: center;
    font-size: 0.9rem;
    color: #6b6b6e;
  }

  @media screen and (max-width: 589px) {
    .product-reviews {
      padding: 3rem 0;
    }

    .product-reviews__heading {
      font-size: 1.6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_reviews",
  "blocks": [{ "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Customer reviews"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_reviews"
    }
  ]
}
{% endschema %}
