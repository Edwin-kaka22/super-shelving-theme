{% doc %}
  Renders a full-width contact page section: a left column with a heading,
  description and store contact details (address, phone, email, hours), and
  a right column with Shopify's built-in contact form.

  Submissions are emailed to the store's customer contact email and are
  visible in Shopify admin under Settings > Notifications.

  @example
  {% section 'contact' %}
{% enddoc %}

<div class="contact full-width">
  <div class="contact__inner">
    <div class="contact__info">
      {% if section.settings.eyebrow != blank %}
        <span class="contact__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="contact__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="contact__description">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.address != blank or section.settings.phone != blank or section.settings.email != blank or section.settings.hours != blank %}
        <ul class="contact__details">
          {% if section.settings.address != blank %}
            <li>
              <span class="contact__detail-icon">{{ 'icon-pin.svg' | inline_asset_content }}</span>
              <span>{{ section.settings.address }}</span>
            </li>
          {% endif %}

          {% if section.settings.phone != blank %}
            <li>
              <span class="contact__detail-icon">{{ 'icon-phone.svg' | inline_asset_content }}</span>
              <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a>
            </li>
          {% endif %}

          {% if section.settings.email != blank %}
            <li>
              <span class="contact__detail-icon">{{ 'icon-mail.svg' | inline_asset_content }}</span>
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </li>
          {% endif %}

          {% if section.settings.hours != blank %}
            <li>
              <span class="contact__detail-icon">{{ 'icon-medal.svg' | inline_asset_content }}</span>
              <span>{{ section.settings.hours }}</span>
            </li>
          {% endif %}
        </ul>
      {% endif %}
    </div>

    <div class="contact__form-wrap">
      {% form 'contact', class: 'contact__form' %}
        {% if form.posted_successfully? %}
          <p class="contact__success" role="status">{{ 'contact.form.success' | t }}</p>
        {% endif %}

        {% if form.errors %}
          <div class="contact__errors" role="alert">
            <p class="contact__errors-heading">{{ 'contact.form.error_heading' | t }}</p>
            <ul>
              {% for field in form.errors %}
                <li>
                  {% if field == 'form' %}
                    {{ form.errors.messages[field] }}
                  {% else %}
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        <div class="contact__field">
          <label for="ContactFormName">{{ 'contact.form.name' | t }}</label>
          <input
            type="text"
            id="ContactFormName"
            name="contact[name]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            autocomplete="name"
          >
        </div>

        <div class="contact__field">
          <label for="ContactFormEmail">{{ 'contact.form.email' | t }}</label>
          <input
            type="email"
            id="ContactFormEmail"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            autocomplete="email"
            autocapitalize="off"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
            {% endif %}
          >
        </div>

        <div class="contact__field">
          <label for="ContactFormPhone">{{ 'contact.form.phone' | t }}</label>
          <input
            type="tel"
            id="ContactFormPhone"
            name="contact[phone]"
            value="{{ form.phone }}"
            autocomplete="tel"
          >
        </div>

        <div class="contact__field">
          <label for="ContactFormMessage">{{ 'contact.form.message' | t }}</label>
          <textarea id="ContactFormMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="contact__submit">
          <span data-submit-label>{{ 'contact.form.submit' | t }}</span>
        </button>
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .contact {
    padding: 4.5rem 0;
    background-color: #ffffff;
  }

  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 22rem) 1fr;
    gap: 4rem;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .contact__eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6e;
  }

  .contact__heading {
    margin: 0.6rem 0 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .contact__description {
    margin: 0.9rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #4a4a4d;
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 1.5rem;
    background-color: #f4f4f5;
    border: 1px solid #e5e5e7;
    border-radius: 0.75rem;
    list-style: none;
  }

  .contact__details li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: #1f2120;
  }

  .contact__details a {
    color: inherit;
    text-decoration: none;
  }

  .contact__details a:hover {
    text-decoration: underline;
  }

  .contact__detail-icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1f2120;
    --icon-stroke-width: 1.5;
  }

  .contact__detail-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contact__field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #1f2120;
  }

  .contact__field input,
  .contact__field textarea {
    padding: 0.8rem 1rem;
    border: 1px solid #e5e5e7;
    background-color: #ffffff;
    font-size: 0.95rem;
    font-family: inherit;
    color: #1f2120;
  }

  .contact__field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .contact__field input:focus-visible,
  .contact__field textarea:focus-visible {
    outline: 2px solid #1f2120;
    outline-offset: 2px;
  }

  .contact__submit {
    position: relative;
    align-self: flex-start;
    overflow: hidden;
    margin-top: 0.5rem;
    padding: 0.9rem 2.25rem;
    border: 1px solid #1f2120;
    border-radius: 999px;
    background-color: #1f2120;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .contact__submit::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: #52564f;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .contact__submit:hover::before {
    transform: scaleX(1);
  }

  .contact__submit:hover {
    border-color: #52564f;
  }

  .contact__submit [data-submit-label] {
    position: relative;
    z-index: 1;
  }

  .contact__success {
    padding: 0.9rem 1.1rem;
    background-color: #eef7ee;
    border: 1px solid #bfe3bf;
    border-radius: 0.6rem;
    color: #1f5c1f;
    font-size: 0.9rem;
  }

  .contact__errors {
    padding: 0.9rem 1.1rem;
    background-color: #fdecec;
    border: 1px solid #f3b8b8;
    border-radius: 0.6rem;
    color: #8a1f1f;
    font-size: 0.9rem;
  }

  .contact__errors-heading {
    margin: 0 0 0.4rem;
    font-weight: 700;
  }

  .contact__errors ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  @media screen and (max-width: 749px) {
    .contact__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Get In Touch"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Have a question about an order, delivery, or which shelving suits your space? Send us a message and we'll get back to you."
    },
    {
      "type": "text",
      "id": "address",
      "label": "t:labels.address",
      "default": "4 Ardmillan Road, Moonee Ponds, VIC"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:labels.phone",
      "default": "+61 431 533 520"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:labels.email",
      "default": "Edwin_10@live.com.au"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "t:labels.hours",
      "default": "Mon - Fri, 9am - 5pm"
    }
  ],
  "presets": [
    {
      "name": "t:general.contact"
    }
  ]
}
{% endschema %}
