{% doc %}
  Renders the "how to choose" part of the Purchasing Guide page: a heading
  and description above a row of numbered `guide-step` cards, followed by
  an optional "need a hand?" call-to-action box.

  @example
  {% section 'guide-steps' %}
{% enddoc %}

<div class="guide-steps full-width">
  <div class="guide-steps__inner">
    <div class="guide-steps__header">
      {% if section.settings.heading != blank %}
        <h2 class="guide-steps__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="guide-steps__description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="guide-steps__list">
        {% content_for 'blocks' %}
      </div>
    {% endif %}

    {% if section.settings.help_heading != blank %}
      <div class="guide-steps__help">
        <h2 class="guide-steps__help-heading">{{ section.settings.help_heading }}</h2>
        {% if section.settings.help_text != blank %}
          <p class="guide-steps__help-text">{{ section.settings.help_text }}</p>
        {% endif %}
        {% if section.settings.help_button_label != blank and section.settings.help_button_link != blank %}
          <a href="{{ section.settings.help_button_link }}" class="guide-steps__help-button">
            {{ section.settings.help_button_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .guide-steps {
    padding: 3rem 0 4.5rem;
    background-color: #ffffff;
  }

  .guide-steps__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .guide-steps__header {
    text-align: center;
  }

  .guide-steps__heading {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .guide-steps__description {
    max-width: 46rem;
    margin: 0.8rem auto 0;
    font-size: 1rem;
    line-height: 1.7;
    color: #4a4a4d;
  }

  .guide-steps__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
    counter-reset: guide-step;
  }

  .guide-steps__list > * {
    display: flex;
  }

  .guide-steps__list > * > .guide-step {
    flex: 1;
    min-width: 0;
  }

  .guide-steps__help {
    margin-top: 2.5rem;
    padding: 2rem;
    border-radius: 1rem;
    background-color: #f4f4f5;
    text-align: center;
  }

  .guide-steps__help-heading {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .guide-steps__help-text {
    max-width: 40rem;
    margin: 0.7rem auto 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #4a4a4d;
  }

  .guide-steps__help-button {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.9rem 2.25rem;
    border: 1px solid #1f2120;
    border-radius: 999px;
    background-color: #1f2120;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .guide-steps__help-button:hover {
    border-color: #52564f;
    background-color: #52564f;
  }

  @media screen and (max-width: 989px) {
    .guide-steps__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 589px) {
    .guide-steps__list {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.guide_steps",
  "blocks": [
    { "type": "guide-step" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "How to choose in four steps"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "t:labels.help_heading",
      "default": "Still Not Sure?"
    },
    {
      "type": "textarea",
      "id": "help_text",
      "label": "t:labels.help_text"
    },
    {
      "type": "text",
      "id": "help_button_label",
      "label": "t:labels.button_label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "help_button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.guide_steps"
    }
  ]
}
{% endschema %}
