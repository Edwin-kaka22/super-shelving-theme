{% doc %}
  Renders a single trust badge card made up of an icon, a heading and a line
  of supporting text. Intended for use inside the `trust-badges` section.

  @example
  {% content_for 'block', type: 'trust-badge', id: 'trust-badge-1' %}
{% enddoc %}

<div class="trust-badge" {{ block.shopify_attributes }}>
  <div class="trust-badge__icon">
    {% case block.settings.icon %}
      {% when 'pin' %}
        {{ 'icon-pin.svg' | inline_asset_content }}
      {% when 'package' %}
        {{ 'icon-package.svg' | inline_asset_content }}
      {% when 'tag' %}
        {{ 'icon-tag.svg' | inline_asset_content }}
      {% when 'medal' %}
        {{ 'icon-medal.svg' | inline_asset_content }}
    {% endcase %}
  </div>

  <div class="trust-badge__content">
    {% if block.settings.heading != blank %}
      <p class="trust-badge__heading">{{ block.settings.heading }}</p>
    {% endif %}

    {% if block.settings.text != blank %}
      <p class="trust-badge__text">{{ block.settings.text }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    max-width: 19rem;
    padding: 1.1rem 1.25rem;
    background-color: #f4f4f5;
    border: 1px solid #e5e5e7;
    border-radius: 0.75rem;
    --icon-stroke-width: 1.5;
  }

  .trust-badge__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1f2120;
  }

  .trust-badge__icon svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .trust-badge__heading {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1f2120;
  }

  .trust-badge__text {
    margin-top: 0.15rem;
    font-size: 0.8rem;
    color: #6b6b6e;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.trust_badge",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:labels.icon",
      "options": [
        { "value": "pin", "label": "t:options.icon.pin" },
        { "value": "package", "label": "t:options.icon.package" },
        { "value": "tag", "label": "t:options.icon.tag" },
        { "value": "medal", "label": "t:options.icon.medal" }
      ],
      "default": "pin"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "Supporting text"
    }
  ],
  "presets": [
    {
      "name": "t:general.trust_badge"
    }
  ]
}
{% endschema %}
