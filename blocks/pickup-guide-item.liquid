{% doc %}
  Renders one readable section inside the `pickup-guide` page: a heading,
  a paragraph of body text, and an optional reference link.

  @example
  {% content_for 'block', type: 'pickup-guide-item', id: 'pickup-guide-item-1' %}
{% enddoc %}

<div class="pickup-guide-item" {{ block.shopify_attributes }}>
  <div class="pickup-guide-item__header">
    <span class="pickup-guide-item__image">
      {% if block.settings.image %}
        {% assign pickup_image_alt = block.settings.heading | escape %}
        {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: pickup_image_alt, width: 80, height: 80 }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'pickup-guide-item__placeholder' }}
      {% endif %}
    </span>

    {% if block.settings.heading != blank %}
      <h2 class="pickup-guide-item__heading">{{ block.settings.heading }}</h2>
    {% endif %}
  </div>

  {% if block.settings.body != blank %}
    <p class="pickup-guide-item__body">{{ block.settings.body | newline_to_br }}</p>
  {% endif %}

  {% if block.settings.link_label != blank and block.settings.link_url != blank %}
    <a href="{{ block.settings.link_url }}" class="pickup-guide-item__link" target="_blank" rel="noopener">
      {{ block.settings.link_label }}
    </a>
  {% endif %}
</div>

{% stylesheet %}
  .pickup-guide-item {
    padding: 2.25rem 0;
    border-bottom: 1px solid #e5e5e7;
  }

  .pickup-guide-item:last-child {
    border-bottom: none;
  }

  .pickup-guide-item__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 0.85rem;
  }

  .pickup-guide-item__image {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: #f4f4f5;
    color: #9a9a9d;
  }

  .pickup-guide-item__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pickup-guide-item__placeholder {
    width: 100%;
    height: 100%;
  }

  .pickup-guide-item__heading {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .pickup-guide-item__body {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.75;
    color: #4a4a4d;
  }

  .pickup-guide-item__link {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #1f2120;
    text-decoration: underline;
  }

  .pickup-guide-item__link:hover {
    color: #52564f;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.pickup_guide_item",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Vehicle type"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.link"
    }
  ]
}
{% endschema %}
