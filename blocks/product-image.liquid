{% doc %}
  Renders a single product photo with an optional caption, linked out
  (e.g. to the collection or a specific product page) when a link is set.
  Intended for use inside the `mdf-gallery` section's image row.

  @example
  {% content_for 'block', type: 'product-image', id: 'product-image-1' %}
{% enddoc %}

{% liquid
  if block.settings.link != blank
    assign wrapper = 'a'
  else
    assign wrapper = 'div'
  endif
%}

<{{ wrapper }}
  class="product-image"
  {% if block.settings.link != blank %}
    href="{{ block.settings.link }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <div class="product-image__media">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 500 }}"
        alt="{{ block.settings.caption | default: 'MDF shelving' }}"
        loading="lazy"
      >
    {% else %}
      {% case block.settings.caption %}
        {% when '150 x 70 x 30cm' %}
          <img src="{{ 'mdf-shelf-150x70x30.png' | asset_url }}" alt="{{ block.settings.caption }}" loading="lazy">
        {% when '180 x 90 x 40cm' %}
          <img src="{{ 'mdf-shelf-180x90x40.png' | asset_url }}" alt="{{ block.settings.caption }}" loading="lazy">
        {% when '180 x 120 x 45cm' %}
          <img src="{{ 'mdf-shelf-180x120x45.png' | asset_url }}" alt="{{ block.settings.caption }}" loading="lazy">
        {% when '180 x 150 x 45cm' %}
          <img src="{{ 'mdf-shelf-180x150x45.png' | asset_url }}" alt="{{ block.settings.caption }}" loading="lazy">
        {% else %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <circle cx="8.5" cy="9.5" r="1.5"></circle>
            <path d="M21 15l-5-5L5 21"></path>
          </svg>
      {% endcase %}
    {% endif %}
  </div>

  {% if block.settings.caption != blank %}
    <span class="product-image__caption">{{ block.settings.caption }}</span>
  {% endif %}
</{{ wrapper }}>

{% stylesheet %}
  .product-image {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .product-image__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #f4f4f5;
    color: #9a9a9d;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .product-image__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .product-image__media svg {
    width: 2.25rem;
    height: 2.25rem;
  }

  .product-image:hover .product-image__media {
    transform: translateY(-4px);
  }

  .product-image:hover .product-image__media img {
    transform: scale(1.05);
  }

  .product-image__caption {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
    color: #1f2120;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:labels.caption"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_image"
    }
  ]
}
{% endschema %}
