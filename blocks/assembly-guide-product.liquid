{% doc %}
  Renders one product type's assembly card inside the `assembly-guide` page:
  a heading, short intro, an assembly video beside a PDF download panel
  (title plus button), and optional numbered steps underneath. Until a PDF
  link is set the button renders without a destination.

  @example
  {% content_for 'block', type: 'assembly-guide-product', id: 'assembly-guide-product-1' %}
{% enddoc %}

{% liquid
  assign assembly_steps = block.settings.steps | newline_to_br | split: '<br />'
  assign image_choice = block.settings.product_image
  assign fallback_image = blank
  case image_choice
    when 'steel_shelving'
      assign fallback_image = 'category-steel-shelving.png' | asset_url
    when 'mdf_shelving'
      assign fallback_image = 'category-mdf-shelving.png' | asset_url
    when 'steel_workbenches'
      assign fallback_image = 'category-steel-workbenches.png' | asset_url
  endcase
%}
<div class="assembly-product" {{ block.shopify_attributes }}>
  <div class="assembly-product__intro">
    {% if block.settings.image != blank %}
      <div class="assembly-product__image">
        {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.heading }}
      </div>
    {% elsif fallback_image != blank %}
      <div class="assembly-product__image">
        <img src="{{ fallback_image }}" alt="{{ block.settings.heading | escape }}" width="1254" height="1254" loading="lazy">
      </div>
    {% endif %}

    <div class="assembly-product__intro-text">
      {% if block.settings.heading != blank %}
        <h2 class="assembly-product__heading">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <p class="assembly-product__description">{{ block.settings.description }}</p>
      {% endif %}
    </div>
  </div>

  <div class="assembly-product__grid">
    <div class="assembly-product__video">
      {% if block.settings.video_file != blank %}
        <div class="assembly-product__player" data-assembly-player>
          {{ block.settings.video_file | video_tag: controls: true, preload: 'metadata', image_size: '1100x', title: block.settings.heading }}
          <button type="button" class="assembly-product__play-button" data-assembly-play aria-label="{{ 'assembly_guide.play_video' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M10 8.5v7l6-3.5-6-3.5z" fill="currentColor" stroke="none"></path>
            </svg>
          </button>
        </div>
      {% elsif block.settings.video != blank %}
        {% if block.settings.video.type == 'youtube' %}
          {% assign video_embed_url = 'https://www.youtube-nocookie.com/embed/' | append: block.settings.video.id %}
        {% else %}
          {% assign video_embed_url = 'https://player.vimeo.com/video/' | append: block.settings.video.id %}
        {% endif %}
        <iframe src="{{ video_embed_url }}" title="{{ block.settings.heading | escape }}" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      {% else %}
        <div class="assembly-product__video-empty">
          <svg class="assembly-product__play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M10 8.5v7l6-3.5-6-3.5z" fill="currentColor" stroke="none"></path>
          </svg>
          <span>{{ 'assembly_guide.video_coming_soon' | t }}</span>
        </div>
      {% endif %}
    </div>

    <div class="assembly-product__pdf">
      <svg class="assembly-product__pdf-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
        <path d="M14 3v5h5"></path>
        <path d="M9 13h6M9 17h4"></path>
      </svg>
      {% if block.settings.manual_title != blank %}
        <h3 class="assembly-product__pdf-title">{{ block.settings.manual_title }}</h3>
      {% endif %}
      {% if block.settings.manual_url != blank %}
        <a href="{{ block.settings.manual_url }}" class="assembly-product__manual" target="_blank" rel="noopener">
          {{ 'assembly_guide.download_manual' | t }}
        </a>
      {% else %}
        <span class="assembly-product__manual">{{ 'assembly_guide.download_manual' | t }}</span>
      {% endif %}
    </div>
  </div>

  {% if block.settings.steps != blank %}
    <ol class="assembly-product__list">
      {% for step in assembly_steps %}
        {% assign step_text = step | strip %}
        {% if step_text != blank %}
          <li>{{ step_text }}</li>
        {% endif %}
      {% endfor %}
    </ol>
  {% endif %}
</div>

{% stylesheet %}
  .assembly-product {
    padding: 2rem;
    border: 1px solid #e5e5e7;
    border-radius: 1rem;
    background-color: #ffffff;
  }

  .assembly-product__intro {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .assembly-product__image {
    flex: none;
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #f4f4f5;
  }

  .assembly-product__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .assembly-product__heading {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .assembly-product__description {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #4a4a4d;
  }

  .assembly-product__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: stretch;
    margin-top: 1.5rem;
  }

  .assembly-product__video {
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #f4f4f5;
  }

  .assembly-product__video video,
  .assembly-product__video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .assembly-product__player {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .assembly-product__play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: none;
    color: #ffffff;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.45));
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .assembly-product__play-button svg {
    display: block;
    width: 3.25rem;
    height: 3.25rem;
  }

  .assembly-product__play-button:hover {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .assembly-product__play-button[hidden] {
    display: none;
  }

  .assembly-product__video-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 100%;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #9a9a9d;
  }

  .assembly-product__pdf {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 1.5rem;
    border-radius: 0.75rem;
    background-color: #f4f4f5;
    text-align: center;
    color: #1f2120;
  }

  .assembly-product__pdf-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .assembly-product__list {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: assembly-step;
  }

  .assembly-product__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 0.7rem 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #4a4a4d;
    counter-increment: assembly-step;
  }

  .assembly-product__list li::before {
    content: counter(assembly-step);
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background-color: #1f2120;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .assembly-product__manual {
    display: inline-block;
    padding: 0.8rem 2rem;
    border: 1px solid #1f2120;
    border-radius: 999px;
    background-color: #1f2120;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .assembly-product__manual:hover {
    border-color: #52564f;
    background-color: #52564f;
  }

  @media screen and (max-width: 749px) {
    .assembly-product {
      padding: 1.25rem;
    }

    .assembly-product__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  // The big play button sits over an uploaded video and hides while it plays.
  // The video's own control bar is only shown while it is playing.
  document.querySelectorAll('[data-assembly-player]').forEach(function (player) {
    var video = player.querySelector('video');
    var button = player.querySelector('[data-assembly-play]');
    if (!video || !button) return;

    var showPlaying = function () {
      button.hidden = true;
      video.controls = true;
    };
    var showStopped = function () {
      button.hidden = false;
      video.controls = false;
    };

    video.controls = false;
    button.addEventListener('click', function () {
      video.play();
    });
    video.addEventListener('play', showPlaying);
    video.addEventListener('pause', showStopped);
    video.addEventListener('ended', showStopped);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.assembly_guide_product",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Product type"
    },
    {
      "type": "select",
      "id": "product_image",
      "label": "t:labels.assembly_image",
      "options": [
        { "value": "none", "label": "t:options.assembly_image.none" },
        { "value": "steel_shelving", "label": "t:options.assembly_image.steel_shelving" },
        { "value": "mdf_shelving", "label": "t:options.assembly_image.mdf_shelving" },
        { "value": "steel_workbenches", "label": "t:options.assembly_image.steel_workbenches" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.assembly_image_upload",
      "info": "t:labels.assembly_image_upload_info"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "video",
      "id": "video_file",
      "label": "t:labels.assembly_video_file",
      "info": "t:labels.assembly_video_file_info"
    },
    {
      "type": "video_url",
      "id": "video",
      "label": "t:labels.assembly_video",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "textarea",
      "id": "steps",
      "label": "t:labels.assembly_steps",
      "info": "t:labels.assembly_steps_info"
    },
    {
      "type": "text",
      "id": "manual_title",
      "label": "t:labels.manual_title",
      "default": "Shelving Assembly Instructions PDF"
    },
    {
      "type": "url",
      "id": "manual_url",
      "label": "t:labels.manual_url",
      "info": "t:labels.manual_url_info"
    }
  ],
  "presets": [
    {
      "name": "t:general.assembly_guide_product"
    }
  ]
}
{% endschema %}
