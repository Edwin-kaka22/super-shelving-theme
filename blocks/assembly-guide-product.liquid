{% doc %}
  Renders one product type's assembly card inside the `assembly-guide` page:
  a heading, short intro, an assembly video beside numbered steps, and an
  optional PDF manual download. Empty video / steps / manual fall back to
  clear "coming soon" states so nothing looks broken before content exists.

  @example
  {% content_for 'block', type: 'assembly-guide-product', id: 'assembly-guide-product-1' %}
{% enddoc %}

{% assign assembly_steps = block.settings.steps | newline_to_br | split: '<br />' %}
<div class="assembly-product" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="assembly-product__heading">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.description != blank %}
    <p class="assembly-product__description">{{ block.settings.description }}</p>
  {% endif %}

  <div class="assembly-product__grid">
    <div class="assembly-product__video">
      {% if block.settings.video != blank %}
        {% if block.settings.video.type == 'youtube' %}
          {% assign video_embed_url = 'https://www.youtube-nocookie.com/embed/' | append: block.settings.video.id %}
        {% else %}
          {% assign video_embed_url = 'https://player.vimeo.com/video/' | append: block.settings.video.id %}
        {% endif %}
        <iframe src="{{ video_embed_url }}" title="{{ block.settings.heading | escape }}" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      {% else %}
        <div class="assembly-product__video-empty">
          <svg class="assembly-product__play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M10 8.5v7l6-3.5-6-3.5z" fill="currentColor" stroke="none"></path>
          </svg>
          <span>{{ 'assembly_guide.video_coming_soon' | t }}</span>
        </div>
      {% endif %}
    </div>

    <div class="assembly-product__steps">
      {% if block.settings.steps != blank %}
        <ol class="assembly-product__list">
          {% for step in assembly_steps %}
            {% assign step_text = step | strip %}
            {% if step_text != blank %}
              <li>{{ step_text }}</li>
            {% endif %}
          {% endfor %}
        </ol>
      {% else %}
        <p class="assembly-product__empty">{{ 'assembly_guide.steps_coming_soon' | t }}</p>
      {% endif %}

      {% if block.settings.manual_url != blank %}
        <a href="{{ block.settings.manual_url }}" class="assembly-product__manual" target="_blank" rel="noopener">
          {{ 'assembly_guide.download_manual' | t }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .assembly-product {
    padding: 2rem;
    border: 1px solid #e5e5e7;
    border-radius: 1rem;
    background-color: #ffffff;
  }

  .assembly-product + .assembly-product {
    margin-top: 1.5rem;
  }

  .assembly-product__heading {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .assembly-product__description {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #4a4a4d;
  }

  .assembly-product__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
    margin-top: 1.5rem;
  }

  .assembly-product__video {
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: #f4f4f5;
  }

  .assembly-product__video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .assembly-product__video-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 100%;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #9a9a9d;
  }

  .assembly-product__list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: assembly-step;
  }

  .assembly-product__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 0.7rem 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #4a4a4d;
    counter-increment: assembly-step;
  }

  .assembly-product__list li::before {
    content: counter(assembly-step);
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background-color: #1f2120;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .assembly-product__empty {
    margin: 0;
    padding: 0.7rem 0;
    font-size: 0.95rem;
    color: #85858b;
  }

  .assembly-product__manual {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.7rem 1.5rem;
    border: 1px solid #1f2120;
    border-radius: 999px;
    background-color: #ffffff;
    color: #1f2120;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .assembly-product__manual:hover {
    background-color: #1f2120;
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .assembly-product {
      padding: 1.25rem;
    }

    .assembly-product__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.assembly_guide_product",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Product type"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "video_url",
      "id": "video",
      "label": "t:labels.assembly_video",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "textarea",
      "id": "steps",
      "label": "t:labels.assembly_steps",
      "info": "t:labels.assembly_steps_info"
    },
    {
      "type": "url",
      "id": "manual_url",
      "label": "t:labels.manual_url",
      "info": "t:labels.manual_url_info"
    }
  ],
  "presets": [
    {
      "name": "t:general.assembly_guide_product"
    }
  ]
}
{% endschema %}
