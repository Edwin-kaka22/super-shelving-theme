{% doc %}
  Renders one numbered step card inside the `guide-steps` section: an
  automatic step number, a heading and a short paragraph.

  @example
  {% content_for 'block', type: 'guide-step', id: 'guide-step-1' %}
{% enddoc %}

<div class="guide-step" {{ block.shopify_attributes }}>
  <span class="guide-step__number"></span>
  {% if block.settings.heading != blank %}
    <h3 class="guide-step__heading">{{ block.settings.heading }}</h3>
  {% endif %}
  {% if block.settings.text != blank %}
    <p class="guide-step__text">{{ block.settings.text }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .guide-step {
    padding: 1.5rem;
    border: 1px solid #e5e5e7;
    border-radius: 1rem;
    background-color: #ffffff;
    counter-increment: guide-step;
  }

  .guide-step__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background-color: #1f2120;
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .guide-step__number::before {
    content: counter(guide-step);
  }

  .guide-step__heading {
    margin: 1rem 0 0;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1f2120;
  }

  .guide-step__text {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: #4a4a4d;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.guide_step",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Step"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text"
    }
  ],
  "presets": [
    {
      "name": "t:general.guide_step"
    }
  ]
}
{% endschema %}
