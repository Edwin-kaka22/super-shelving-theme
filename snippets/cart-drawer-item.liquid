{% doc %}
  Renders a single line item row inside the cart drawer: image, title,
  variant title (if not the default), a quantity stepper, a line price, and
  a remove button. Used both for the drawer's initial server render and for
  every re-render after an AJAX cart change (via the cart-drawer section's
  Section Rendering API response), so there is one source of truth for the
  markup.

  @param {line_item} item - The cart line item to render

  @example
  {% render 'cart-drawer-item', item: item %}
{% enddoc %}

<li class="cart-drawer__item" data-cart-drawer-item data-line-key="{{ item.key }}">
  <a href="{{ item.url }}" class="cart-drawer__item-image" tabindex="-1">
    {% if item.image %}
      <img
        src="{{ item.image | image_url: width: 200 }}"
        alt="{{ item.image.alt | default: item.product.title | escape }}"
        loading="lazy"
        width="100"
        height="100"
      >
    {% endif %}
  </a>

  <div class="cart-drawer__item-info">
    <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title }}</a>

    {% unless item.variant.title == 'Default Title' %}
      <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
    {% endunless %}

    <div class="cart-drawer__item-row">
      <div class="cart-drawer__qty">
        <button type="button" class="cart-drawer__qty-btn" data-cart-qty-minus aria-label="{{ 'products.product.decrease_quantity' | t }}">&minus;</button>
        <span class="cart-drawer__qty-value" data-cart-qty-value>{{ item.quantity }}</span>
        <button type="button" class="cart-drawer__qty-btn" data-cart-qty-plus aria-label="{{ 'products.product.increase_quantity' | t }}">+</button>
      </div>

      <p class="cart-drawer__item-price">
        {% if item.variant.compare_at_price > item.variant.price %}
          <span class="cart-drawer__item-price--sale">{{ item.final_line_price | money }}</span>
          <span class="cart-drawer__item-price--compare">{{ item.variant.compare_at_price | times: item.quantity | money }}</span>
        {% else %}
          {{ item.final_line_price | money }}
        {% endif %}
      </p>
    </div>
  </div>

  <button type="button" class="cart-drawer__item-remove" data-cart-remove aria-label="{{ 'cart.remove' | t }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
</li>
